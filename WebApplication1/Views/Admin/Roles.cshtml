@section Scripts {
    <script>
        // 1. CHUYỂN ĐỔI VAI TRÒ Ở CỘT TRÁI
        function selectRole(button) {
            document.querySelectorAll('.role-item-btn').forEach(b => b.classList.remove('active'));
            button.classList.add('active');

            const roleName = button.dataset.roleName;
            const roleDesc = button.dataset.roleDesc;
            const roleIcon = button.dataset.roleIcon;
            const roleColor = button.dataset.roleColor;
            const userCount = button.dataset.userCount;
            const roleId = button.dataset.roleId;

            document.getElementById('selectedRoleName').innerText = roleName;
            document.getElementById('selectedRoleDesc').innerText = roleDesc;
            document.getElementById('selectedUserCountTag').innerText = userCount + ' người dùng';
            document.getElementById('tabMemberCount').innerText = userCount;

            const iconContainer = document.getElementById('selectedRoleIcon');
            iconContainer.className = 'role-detail-icon ' + roleColor;
            iconContainer.innerHTML = `<i class="fa-solid ${roleIcon}"></i>`;

            // Cập nhật trạng thái mẫu của checkbox tùy theo vai trò
            const checkboxes = document.querySelectorAll('.perm-checkbox');
            if (roleId === 'admin') {
                checkboxes.forEach(cb => cb.checked = true);
            } else if (roleId === 'sinhvien') {
                checkboxes.forEach(cb => cb.checked = false);
            } else if (roleId === 'truongbomon') {
                checkboxes.forEach((cb, index) => cb.checked = (index % 2 === 0 || index < 10));
            } else if (roleId === 'khaothi') {
                checkboxes.forEach((cb, index) => cb.checked = (index > 4 && index < 15));
            } else {
                // Giảng viên mặc định
                document.getElementById('p_q1').checked = true;
                document.getElementById('p_q2').checked = true;
                document.getElementById('p_q3').checked = true;
                document.getElementById('p_q4').checked = false;
                document.getElementById('p_q5').checked = true;
                document.getElementById('p_e1').checked = true;
                document.getElementById('p_e2').checked = true;
                document.getElementById('p_e3').checked = true;
                document.getElementById('p_e4').checked = false;
                document.getElementById('p_e5').checked = false;
            }
        }

        // 2. CHUYỂN SUB TAB (PHÂN QUYỀN / THÀNH VIÊN)
        function switchRoleSubTab(evt, tabId) {
            const tabs = document.querySelectorAll('.role-sub-tab-btn');
            tabs.forEach(t => t.classList.remove('active'));
            evt.currentTarget.classList.add('active');

            const panes = document.querySelectorAll('.role-tab-pane');
            panes.forEach(p => p.classList.add('d-none'));

            const target = document.getElementById(tabId);
            if (target) {
                target.classList.remove('d-none');
            }
        }

        // 3. CHỌN TẤT CẢ / BỎ CHỌN TẤT CẢ QUYỀN
        let allChecked = false;
        function toggleAllPermissions() {
            const checkboxes = document.querySelectorAll('.perm-checkbox');
            allChecked = !allChecked;
            checkboxes.forEach(cb => cb.checked = allChecked);
            document.getElementById('btnToggleAllPerms').innerText = allChecked ? 'Bỏ chọn tất cả' : 'Chọn tất cả';
        }

        // 4. TÌM KIẾM QUYỀN HẠN NHANH
        const searchInput = document.getElementById('searchPermInput');
        if (searchInput) {
            searchInput.addEventListener('keyup', function () {
                const term = this.value.toLowerCase().trim();
                const items = document.querySelectorAll('.perm-item-box');
                items.forEach(item => {
                    const text = item.innerText.toLowerCase();
                    item.style.display = text.includes(term) ? 'flex' : 'none';
                });
            });
        }
    </script>
}

