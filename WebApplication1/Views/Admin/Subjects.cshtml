@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tableRows = document.querySelectorAll('#subjectTable tbody tr');
            const detailCard = document.getElementById('subjectDetailCard');

            // 1. TƯƠNG TÁC CHỌN DÒNG VÀ HIỂN THỊ CHI TIẾT
            tableRows.forEach(row => {
                row.addEventListener('click', function (e) {
                    // Tránh trigger khi bấm trực tiếp vào checkbox
                    if (e.target.type === 'checkbox') return;

                    tableRows.forEach(r => r.classList.remove('row-active'));
                    this.classList.add('row-active');

                    // Lấy dữ liệu từ dataset
                    const code = this.dataset.code;
                    const name = this.dataset.name;
                    const credits = this.dataset.credits;
                    const dept = this.dataset.dept;
                    const subdept = this.dataset.subdept;
                    const type = this.dataset.type;
                    const status = this.dataset.status;
                    const statusClass = this.dataset.statusClass;
                    const desc = this.dataset.desc;

                    // Đổ dữ liệu vào Hero Banner
                    document.getElementById('detailCode').innerText = code;
                    document.getElementById('detailName').innerText = name;
                    document.getElementById('detailCredits').innerText = credits;
                    document.getElementById('detailDept').innerText = dept;
                    document.getElementById('detailType').innerText = type;

                    const statusPill = document.getElementById('detailStatusPill');
                    statusPill.className = 'status-pill ' + statusClass;
                    document.getElementById('detailStatusText').innerText = status;

                    // Đổ dữ liệu vào Tab Thông tin chung
                    document.getElementById('infoCode').innerText = code;
                    document.getElementById('infoName').innerText = name;
                    document.getElementById('infoCredits').innerText = credits;
                    document.getElementById('infoType').innerText = type;
                    document.getElementById('infoDept').innerText = dept;
                    document.getElementById('infoSubDept').innerText = subdept;
                    document.getElementById('infoDesc').innerText = desc;

                    const infoStatusPill = document.getElementById('infoStatusPill');
                    infoStatusPill.className = 'status-pill ' + statusClass;
                    document.getElementById('infoStatus').innerText = status;

                    // Hiển thị panel nếu đang bị ẩn
                    detailCard.style.display = 'block';
                });
            });

            // 2. CHECKBOX CHỌN TẤT CẢ
            const checkAllTop = document.getElementById('checkAllSubjects');
            const headCheck = document.getElementById('tableHeadCheck');
            const rowChecks = document.querySelectorAll('.row-select-check');
            const btnActivate = document.getElementById('btnBatchActivate');
            const btnPause = document.getElementById('btnBatchPause');
            const btnDelete = document.getElementById('btnBatchDelete');

            function updateBatchButtons() {
                const checkedCount = document.querySelectorAll('.row-select-check:checked').length;
                const hasSelected = checkedCount > 0;
                btnActivate.disabled = !hasSelected;
                btnPause.disabled = !hasSelected;
                btnDelete.disabled = !hasSelected;
            }

            function setAllCheckboxes(checked) {
                rowChecks.forEach(cb => cb.checked = checked);
                checkAllTop.checked = checked;
                headCheck.checked = checked;
                updateBatchButtons();
            }

            if (checkAllTop) {
                checkAllTop.addEventListener('change', function () {
                    setAllCheckboxes(this.checked);
                });
            }

            if (headCheck) {
                headCheck.addEventListener('change', function () {
                    setAllCheckboxes(this.checked);
                });
            }

            rowChecks.forEach(cb => {
                cb.addEventListener('change', function () {
                    const total = rowChecks.length;
                    const checkedCount = document.querySelectorAll('.row-select-check:checked').length;
                    checkAllTop.checked = (total === checkedCount);
                    headCheck.checked = (total === checkedCount);
                    updateBatchButtons();
                });
            });

            // 3. TÌM KIẾM DỮ LIỆU BẢNG NHANH
            const searchInput = document.getElementById('tableSearchInput');
            if (searchInput) {
                searchInput.addEventListener('keyup', function () {
                    const term = this.value.toLowerCase().trim();
                    tableRows.forEach(row => {
                        const text = row.innerText.toLowerCase();
                        row.style.display = text.includes(term) ? '' : 'none';
                    });
                });
            }
        });

        // CHUYỂN TAB TRONG PANEL CHI TIẾT
        function switchDetailTab(evt, tabId) {
            const tabs = document.querySelectorAll('.detail-tab-btn');
            tabs.forEach(t => t.classList.remove('active'));
            evt.currentTarget.classList.add('active');

            const panes = document.querySelectorAll('.tab-pane-content');
            panes.forEach(p => p.classList.add('d-none'));

            const target = document.getElementById(tabId);
            if (target) {
                target.classList.remove('d-none');
            }
        }
    </script>
}

