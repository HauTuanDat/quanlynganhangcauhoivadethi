@section Scripts {
    <script>
        // 1. CHỌN KHOA TRÊN CÂY
        function selectFaculty(btn, code, name, leader, office, email, deptCount, teacherCount, subjectCount) {
            document.querySelectorAll('.faculty-header-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.dept-child-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            // Mở accordion con
            const parent = btn.closest('.tree-group-item');
            const childrenList = parent.querySelector('.dept-children-list');
            if (childrenList) {
                childrenList.classList.toggle('d-none');
            }

            // Đổ dữ liệu vào Hero Banner
            document.getElementById('detailUnitName').innerText = name;
            document.getElementById('detailUnitCode').innerText = code;
            document.getElementById('detailUnitLeader').innerText = leader;
            document.getElementById('detailUnitParent').innerText = office + ' - ' + email;
            document.getElementById('countSubj').innerText = subjectCount;
            document.getElementById('countTeacher').innerText = teacherCount;

            const iconContainer = document.getElementById('detailUnitIcon');
            iconContainer.innerHTML = '<i class="fa-solid fa-landmark"></i>';
        }

        // 2. CHỌN BỘ MÔN TRÊN CÂY
        function selectDept(btn, code, name, parentName, leader, teacherCount, subjectCount) {
            document.querySelectorAll('.dept-child-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            document.getElementById('detailUnitName').innerText = name;
            document.getElementById('detailUnitCode').innerText = code;
            document.getElementById('detailUnitLeader').innerText = leader;
            document.getElementById('detailUnitParent').innerText = parentName;
            document.getElementById('countSubj').innerText = subjectCount;
            document.getElementById('countTeacher').innerText = teacherCount;

            const iconContainer = document.getElementById('detailUnitIcon');
            iconContainer.innerHTML = '<i class="fa-solid fa-sitemap"></i>';
        }

        // 3. CHUYỂN SUB TABS CHI TIẾT
        function switchUnitTab(evt, tabId) {
            const tabs = document.querySelectorAll('.unit-sub-tab-btn');
            tabs.forEach(t => t.classList.remove('active'));
            evt.currentTarget.classList.add('active');

            const panes = document.querySelectorAll('.unit-tab-pane');
            panes.forEach(p => p.classList.add('d-none'));

            const target = document.getElementById(tabId);
            if (target) {
                target.classList.remove('d-none');
            }
        }
    </script>
}

