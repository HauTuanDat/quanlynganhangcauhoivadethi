@section Scripts {
    <script>
        // 1. CHUYỂN TAB CẤU HÌNH
        function switchSettingsTab(evt, tabId) {
            const tabs = document.querySelectorAll('.settings-tab-btn');
            tabs.forEach(t => t.classList.remove('active'));
            evt.currentTarget.classList.add('active');

            const panes = document.querySelectorAll('.settings-tab-pane');
            panes.forEach(p => p.classList.add('d-none'));

            const target = document.getElementById(tabId);
            if (target) {
                target.classList.remove('d-none');
            }
        }

        // 2. ĐỒNG HỒ THỜI GIAN THỰC (REAL-TIME CLOCK)
        function updateLiveClock() {
            const now = new Date();
            const days = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
            const dayName = days[now.getDay()];

            const day = String(now.getDate()).padStart(2, '0');
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const year = now.getFullYear();

            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');

            const dateStr = `${dayName}, ${day}/${month}/${year}`;
            const timeStr = `${hours}:${minutes}:${seconds}`;

            const dateElem = document.getElementById('liveDateDisplay');
            const timeElem = document.getElementById('liveTimeDisplay');

            if (dateElem) dateElem.innerText = dateStr;
            if (timeElem) timeElem.innerText = timeStr;
        }

        setInterval(updateLiveClock, 1000);
        updateLiveClock();
    </script>
}

