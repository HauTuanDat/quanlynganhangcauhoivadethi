@model WebApplication1.Models.RegisterViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký tài khoản - ExamBank</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
            body, html {
                height: 100%;
                margin: 0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .register-container {
                min-height: 100vh;
            }

            .left-banner {
                background: linear-gradient(135deg, #0d47a1, #1565c0, #1976d2);
                color: white;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 40px;
            }

            .right-form {
                background-color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px;
            }

            .form-wrapper {
                width: 100%;
                max-width: 450px;
            }

            .form-control-custom {
                padding: 10px 15px 10px 40px;
                border-radius: 8px;
                border: 1px solid #ced4da;
            }

            .input-group-icon {
                position: relative;
            }

                .input-group-icon i {
                    position: absolute;
                    left: 14px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #6c757d;
                }

            .btn-register {
                background-color: #0d6efd;
                border: none;
                padding: 12px;
                border-radius: 8px;
                font-weight: 600;
            }

                .btn-register:hover {
                    background-color: #0b5ed7;
                }
    </style>
</head>
<body>

    <div class="container-fluid register-container p-0">
        <div class="row g-0 min-vh-100">

            <!-- Banner bên trái -->
            <div class="col-lg-6 left-banner d-none d-lg-flex">
                <div>
                    <h3><i class="fa-solid fa-graduation-cap"></i> ExamBank</h3>
                </div>
                <div class="my-auto text-center">
                    <h2 class="fw-bold mb-3">Tham gia hệ thống ExamBank</h2>
                    <p class="text-white-50 mb-4">Hệ thống quản trị ngân hàng câu hỏi, hỗ trợ giảng viên soạn thảo và tổ chức thi trực tuyến tiêu chuẩn.</p>
                    <img src="~/img/bg-login.png" asp-append-version="true" alt="Banner" class="img-fluid rounded shadow" style="max-height: 250px;" />
                </div>
                <div class="text-white-50 small">
                    <span>© 2026 ExamBank. Hệ thống quản lý ngân hàng câu hỏi và đề thi</span>
                </div>
            </div>

            <!-- Form đăng ký bên phải -->
            <div class="col-lg-6 right-form">
                <div class="form-wrapper">
                    <div class="text-center mb-4">
                        <i class="fa-solid fa-user-plus text-primary fs-1 mb-2"></i>
                        <h2 class="fw-bold text-dark">Tạo tài khoản mới</h2>
                        <p class="text-muted small">Điền thông tin để đăng ký tài khoản cán bộ/giảng viên</p>
                    </div>

                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <!-- Họ và tên -->
                        <div class="mb-3 input-group-icon">
                            <i class="fa-regular fa-id-card"></i>
                            <input asp-for="FullName" class="form-control form-control-custom" placeholder="Họ và tên" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Tên đăng nhập -->
                        <div class="mb-3 input-group-icon">
                            <i class="fa-regular fa-user"></i>
                            <input asp-for="Username" class="form-control form-control-custom" placeholder="Tên đăng nhập" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3 input-group-icon">
                            <i class="fa-regular fa-envelope"></i>
                            <input asp-for="Email" class="form-control form-control-custom" placeholder="Email trường / cơ quan" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Mật khẩu -->
                        <div class="mb-3 input-group-icon">
                            <i class="fa-solid fa-lock"></i>
                            <input asp-for="Password" class="form-control form-control-custom" placeholder="Mật khẩu" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Xác nhận mật khẩu -->
                        <div class="mb-3 input-group-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                            <input asp-for="ConfirmPassword" class="form-control form-control-custom" placeholder="Xác nhận mật khẩu" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-register text-white">
                                <i class="fa-solid fa-user-check me-2"></i> Đăng ký tài khoản
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <span class="text-muted small">Đã có tài khoản?</span>
                            <a asp-action="Login" class="text-decoration-none small text-primary fw-bold ms-1">Đăng nhập ngay</a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>

</body>
</html>