@model WebApplication1.Models.LoginViewModel
@{
    Layout = null; // Tắt layout chung nếu trang đăng nhập đứng độc lập fullscreen
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - ExamBank</title>
    <!-- Nhúng Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Nhúng FontAwesome để dùng icon -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
            body, html {
                height: 100%;
                margin: 0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }
            .login-container {
                height: 100vh;
            }
            /* Phân vùng bên trái: Xanh dương chủ đạo */
            .left-banner {
                background: linear-gradient(135deg, #0d47a1, #1565c0, #1976d2);
                color: white;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 40px;
                width : 40%;
            }
            /* Phân vùng bên phải: Form trắng */
            .right-form {
                background-color: #ffffff;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px;
                width : 60%;
            }
            .form-wrapper {
                width: 100%;
                max-width: 400px;
            }
            .form-control-custom {
                padding: 12px 15px 12px 40px;
                border-radius: 8px;
                border: 1px solid #ced4da;
            }
            .input-group-icon {
                position: relative;
            }
            .input-group-icon i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #6c757d;
            }
            .btn-login {
                background-color: blue;
                border: none;
                padding: 12px;
                border-radius: 8px;
                font-weight: 600;
            }
            .btn-login:hover {
                background-color: #0b5ed7;
            }
            
    </style>
</head>
<body>

    <div class="container-fluid login-container p-0">
        <div class="row g-0 h-100">

            <!-- BÊN TRÁI: Banner giới thiệu hệ thống -->
            <div class="col-lg-7 left-banner d-none d-lg-flex">
                <div>
                    <h3><i class="fa-solid fa-graduation-cap"></i> ExamBank</h3>
                </div>
                <div class="my-auto text-center">
                    <h1 class="fw-bold mb-3">Hệ thống quản lý ngân hàng câu hỏi và đề thi</h1>
                    <p class="text-white-50 mb-4">Giải pháp hiệu quả cho công tác quản lý đề thi, ngân hàng câu hỏi và đánh giá chất lượng đào tạo.</p>
                    <!-- Minh họa ảnh hoặc vector -->
                    <img src="~/img/anhbackgoroundlogin.png" asp-append-version="true" alt="Illustration" class="img-fluid rounded shadow" />
                </div>
                <div class="text-white-50 small">
                    <span>© 2026 ExamBank. Trường Đại học Công nghệ Thông tin</span>
                </div>
            </div>

            <!-- BÊN PHẢI: Form đăng nhập -->
            <div class="col-lg-5 right-form">
                <div class="form-wrapper">
                    <div class="text-center mb-4">
                        <i class="fa-solid fa-graduation-cap text-primary fs-1 mb-2"></i>
                        <h2 class="fw-bold text-dark">Chào mừng trở lại!</h2>
                        <p class="text-muted small">Đăng nhập để tiếp tục sử dụng hệ thống ExamBank.</p>
                    </div>

                    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                    {
                        <div class="mb-3 input-group-icon">
                            <i class="fa-regular fa-user"></i>
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control form-control-custom", placeholder = "Tên đăng nhập" })
                            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <div class="mb-3 input-group-icon">
                            <i class="fa-solid fa-lock"></i>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control form-control-custom", placeholder = "Mật khẩu" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <div class="mb-3 form-check d-flex justify-content-between align-items-center">
                            <div>
                                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input", id = "rememberMe" })
                                <label class="form-check-label small" for="rememberMe">Ghi nhớ đăng nhập</label>
                            </div>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-login text-white">
                                <i class="fa-solid fa-right-to-bracket me-2"></i> Đăng nhập
                            </button>
                        </div>

                        <div class="text-center mt-4">
                            <hr class="text-muted" />
                            <span class="text-muted small bg-white px-2 position-relative" style="top: -22px;">Hoặc</span>
                            <div class="text-center mt-3">
                                <span class="text-muted small">Chưa có tài khoản?</span>
                                <a asp-action="Register" class="text-decoration-none small text-primary fw-bold ms-1">Đăng ký ngay</a>
                            </div>
                            <div class="mt-n2">
                                <a href="#" class="text-decoration-none small text-primary"><i class="fa-solid fa-circle-question"></i> Liên hệ hỗ trợ</a>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>

</body>
</html>