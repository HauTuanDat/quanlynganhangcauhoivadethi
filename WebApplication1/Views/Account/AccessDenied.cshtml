@{
    Layout = null;
    ViewData["Title"] = "Từ chối quyền truy cập - ExamBank";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>403 - Từ chối quyền truy cập</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #0d1e46 0%, #091431 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            color: #ffffff;
            margin: 0;
            padding: 20px;
        }
        .error-card {
            background: #ffffff;
            color: #1e293b;
            border-radius: 20px;
            padding: 48px 40px;
            max-width: 520px;
            width: 100%;
            text-align: center;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }
        .icon-circle {
            width: 88px;
            height: 88px;
            border-radius: 50%;
            background: #fee2e2;
            color: #dc2626;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            margin-bottom: 24px;
        }
        .error-code {
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #dc2626;
            margin-bottom: 8px;
        }
        .error-title {
            font-size: 24px;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 12px;
        }
        .error-desc {
            font-size: 14.5px;
            color: #64748b;
            line-height: 1.6;
            margin-bottom: 32px;
        }
        .btn-custom {
            padding: 12px 24px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            text-decoration: none;
        }
        .btn-primary-custom {
            background-color: #2563eb;
            color: #ffffff;
            border: none;
        }
        .btn-primary-custom:hover {
            background-color: #1d4ed8;
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35);
        }
        .btn-secondary-custom {
            background-color: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
        }
        .btn-secondary-custom:hover {
            background-color: #e2e8f0;
            color: #1e293b;
        }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="icon-circle">
            <i class="fa-solid fa-shield-halved"></i>
        </div>
        <div class="error-code">Lỗi 403 - Forbidden</div>
        <h1 class="error-title">Từ chối quyền truy cập</h1>
        <p class="error-desc">
            Tài khoản của bạn không có quyền truy cập vào phân hệ này. Khu vực Quản trị hệ thống (Admin) chỉ dành riêng cho tài khoản có vai trò Quản trị viên.
        </p>

        <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
            <a href="@Url.Action("Index", "Teacher")" class="btn-custom btn-primary-custom">
                <i class="fa-solid fa-chalkboard-user"></i>
                <span>Về Cổng Giảng viên</span>
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn-custom btn-secondary-custom w-100">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    <span>Đổi tài khoản khác</span>
                </button>
            </form>
        </div>
    </div>
</body>
</html>

