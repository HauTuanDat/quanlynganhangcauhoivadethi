@{
    ViewData["Title"] = "Ngân hàng câu hỏi bộ môn - ExamBank";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Top Header Navbar -->
<div class="px-4 py-3 bg-white border-bottom d-flex align-items-center justify-content-between shadow-sm">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="DepartmentHead" asp-action="Index" class="text-decoration-none text-secondary">Trưởng bộ môn</a></li>
            <li class="breadcrumb-item active fw-bold" style="color: #6366f1;" aria-current="page">Ngân hàng câu hỏi bộ môn</li>
        </ol>
    </nav>
    <div class="d-flex gap-2">
        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-bold">
            <i class="fa-solid fa-database me-1"></i> 1,280 câu hỏi chính thức
        </span>
    </div>
</div>

<div class="p-4" style="background-color: #f8fafc; min-height: calc(100vh - 75px);">
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm câu hỏi trong ngân hàng bộ môn..." />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select class="form-select">
                        <option value="">Tất cả môn học</option>
                        <option value="IT3020" selected>Cơ sở dữ liệu (IT3020)</option>
                        <option value="IT3040">Cơ sở dữ liệu nâng cao</option>
                        <option value="IT3050">Hệ quản trị CSDL</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <select class="form-select">
                        <option value="">Tất cả độ khó</option>
                        <option value="1">Nhận biết</option>
                        <option value="2">Thông hiểu</option>
                        <option value="3">Vận dụng</option>
                        <option value="4">Vận dụng cao</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <button class="btn btn-primary w-100 fw-semibold rounded-3" style="background-color: #4f46e5; border-color: #4f46e5;">
                        <i class="fa-solid fa-filter me-1"></i> Lọc dữ liệu
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Table of Questions -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">Mã câu hỏi</th>
                        <th>Nội dung câu hỏi</th>
                        <th>Môn học</th>
                        <th>Cấp độ Bloom</th>
                        <th>Tác giả</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4 fw-bold">#Q-1045</td>
                        <td>
                            <div class="fw-semibold text-dark text-truncate" style="max-width: 380px;">
                                Khái niệm ACID trong xử lý giao dịch (Transaction) của hệ CSDL gồm những tính chất nào?
                            </div>
                            <small class="text-muted">Chương 5: Quản lý giao dịch</small>
                        </td>
                        <td><span class="badge bg-light text-dark border">Cơ sở dữ liệu</span></td>
                        <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">Thông hiểu</span></td>
                        <td>ThS. Nguyễn Văn A</td>
                        <td><span class="badge bg-success-subtle text-success">Đã vào ngân hàng (Approved)</span></td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                <i class="fa-solid fa-eye me-1"></i> Chi tiết
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4 fw-bold">#Q-1042</td>
                        <td>
                            <div class="fw-semibold text-dark text-truncate" style="max-width: 380px;">
                                Thuật toán phân rã bảo toàn thông tin và bảo toàn phụ thuộc hàm về dạng chuẩn 3NF.
                            </div>
                            <small class="text-muted">Chương 2: Chuẩn hóa dữ liệu</small>
                        </td>
                        <td><span class="badge bg-light text-dark border">Cơ sở dữ liệu nâng cao</span></td>
                        <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">Vận dụng cao</span></td>
                        <td>TS. Lê Hoàng Nam</td>
                        <td><span class="badge bg-success-subtle text-success">Đã vào ngân hàng (Approved)</span></td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                <i class="fa-solid fa-eye me-1"></i> Chi tiết
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

