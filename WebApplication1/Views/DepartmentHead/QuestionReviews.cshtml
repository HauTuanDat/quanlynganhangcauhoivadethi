@{
    ViewData["Title"] = "Kiểm duyệt câu hỏi Cấp 1 - ExamBank";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Top Header Navbar -->
<div class="px-4 py-3 bg-white border-bottom d-flex align-items-center justify-content-between shadow-sm">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="DepartmentHead" asp-action="Index" class="text-decoration-none text-secondary">Trưởng bộ môn</a></li>
            <li class="breadcrumb-item active fw-bold" style="color: #6366f1;" aria-current="page">Kiểm duyệt câu hỏi Cấp 1</li>
        </ol>
    </nav>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill fw-bold">
            <i class="fa-solid fa-hourglass-half me-1"></i> 12 câu đang chờ duyệt
        </span>
    </div>
</div>

<!-- Main Container -->
<div class="p-4" style="background-color: #f8fafc; min-height: calc(100vh - 75px);">

    <!-- Filter & Search Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Tìm theo mã câu hỏi, từ khóa nội dung..." />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select class="form-select">
                        <option value="">Tất cả môn học trực thuộc</option>
                        <option value="IT3020" selected>Cơ sở dữ liệu (IT3020)</option>
                        <option value="IT3040">Cơ sở dữ liệu nâng cao</option>
                        <option value="IT3050">Hệ quản trị CSDL</option>
                        <option value="IT3060">Khai phá dữ liệu</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select class="form-select">
                        <option value="">Tất cả Giảng viên</option>
                        <option value="gv1">ThS. Nguyễn Văn A</option>
                        <option value="gv2">TS. Lê Hoàng Nam</option>
                        <option value="gv3">ThS. Phạm Thu Trang</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button class="btn btn-primary w-100 fw-semibold rounded-3" style="background-color: #4f46e5; border-color: #4f46e5;">
                        <i class="fa-solid fa-filter me-1"></i> Lọc
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Question Review Cards List -->
    <div class="row g-4">
        <!-- Question Item 1 -->
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden border-start border-4 border-warning">
                <div class="card-header bg-white py-3 px-4 d-flex align-items-center justify-content-between border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-dark fw-bold">#Q-1082</span>
                        <span class="badge bg-light text-dark border">Cơ sở dữ liệu (IT3020)</span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Cấp độ Bloom: Thông hiểu</span>
                        <span class="badge bg-secondary-subtle text-secondary border">Phiên bản v1.0</span>
                    </div>
                    <div class="small text-muted">
                        <i class="fa-solid fa-user-pen me-1"></i> Người soạn: <strong>ThS. Nguyễn Văn A</strong> • Gửi lúc: 10:15 - Hôm nay
                    </div>
                </div>
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3">
                        Nội dung câu hỏi:
                    </h6>
                    <p class="fs-6 text-dark mb-3">
                        Trong mô hình dữ liệu quan hệ, thuộc tính hoặc tập thuộc tính nào sau đây được chọn làm <strong>Khóa chính (Primary Key)</strong> phải thỏa mãn ràng buộc toàn vẹn thực thể nào?
                    </p>

                    <!-- Danh sách các phương án A, B, C, D -->
                    <div class="row g-2 mb-4">
                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-3 border bg-light">
                                <span class="fw-bold text-secondary me-2">A.</span> Giá trị có thể trùng lặp nhưng không được rỗng (NULL).
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-3 border bg-success-subtle border-success text-success-emphasis fw-semibold">
                                <span class="fw-bold me-2"><i class="fa-solid fa-check-circle text-success"></i> B.</span> Giá trị phải duy nhất và không được phép chứa giá trị NULL. (Đáp án đúng)
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-3 border bg-light">
                                <span class="fw-bold text-secondary me-2">C.</span> Giá trị phải là số nguyên tự tăng và bắt buộc tham chiếu đến bảng khác.
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-3 border bg-light">
                                <span class="fw-bold text-secondary me-2">D.</span> Mỗi bảng có thể có nhiều khóa chính độc lập với nhau.
                            </div>
                        </div>
                    </div>

                    <!-- Phần giải thích của Giảng viên -->
                    <div class="p-3 rounded-3 bg-light border-start border-3 border-info mb-3">
                        <div class="small fw-bold text-info-emphasis mb-1"><i class="fa-solid fa-lightbulb me-1"></i> Lời giải thích của Giảng viên:</div>
                        <div class="small text-muted">
                            Theo định lý ràng buộc toàn vẹn thực thể (Entity Integrity), mọi bộ (tuple) trong bảng phải được phân biệt duy nhất bằng khóa chính và không thuộc tính nào cấu thành khóa chính được mang giá trị NULL.
                        </div>
                    </div>

                    <!-- Nút thao tác của Trưởng bộ môn -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between pt-3 border-top gap-2">
                        <div class="text-muted small">
                            <i class="fa-solid fa-circle-info text-warning me-1"></i> Trưởng bộ môn duyệt đạt sẽ chuyển câu hỏi sang Phòng Khảo thí để thẩm định Cấp 2.
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-danger fw-semibold px-3 rounded-pill" data-bs-toggle="modal" data-bs-target="#rejectModal">
                                <i class="fa-solid fa-xmark me-1"></i> Từ chối
                            </button>
                            <button type="button" class="btn btn-outline-warning fw-semibold px-3 rounded-pill text-dark" data-bs-toggle="modal" data-bs-target="#reviseModal">
                                <i class="fa-solid fa-rotate-left me-1"></i> Yêu cầu sửa đổi
                            </button>
                            <button type="button" class="btn btn-success fw-semibold px-4 rounded-pill shadow-sm" onclick="alert('Đã phê duyệt Cấp 1 thành công! Câu hỏi được chuyển lên Phòng Khảo thí.')">
                                <i class="fa-solid fa-check me-1"></i> Phê duyệt Cấp 1
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Question Item 2 -->
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden border-start border-4 border-warning">
                <div class="card-header bg-white py-3 px-4 d-flex align-items-center justify-content-between border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-dark fw-bold">#Q-1081</span>
                        <span class="badge bg-light text-dark border">Cơ sở dữ liệu nâng cao</span>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Cấp độ Bloom: Vận dụng</span>
                        <span class="badge bg-secondary-subtle text-secondary border">Phiên bản v1.0</span>
                    </div>
                    <div class="small text-muted">
                        <i class="fa-solid fa-user-pen me-1"></i> Người soạn: <strong>TS. Lê Hoàng Nam</strong> • Gửi lúc: 08:40 - Hôm nay
                    </div>
                </div>
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3">
                        Nội dung câu hỏi:
                    </h6>
                    <p class="fs-6 text-dark mb-3">
                        Cho lược đồ quan hệ $R(A, B, C, D, E)$ với tập phụ thuộc hàm $F = \{A \rightarrow B, BC \rightarrow D, D \rightarrow E\}$. Khóa dự tuyển (Candidate Key) của $R$ là tập thuộc tính nào?
                    </p>

                    <div class="row g-2 mb-4">
                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-3 border bg-success-subtle border-success text-success-emphasis fw-semibold">
                                <span class="fw-bold me-2"><i class="fa-solid fa-check-circle text-success"></i> A.</span> $\{A, C\}$ (Đáp án đúng)
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-3 border bg-light">
                                <span class="fw-bold text-secondary me-2">B.</span> $\{A, B\}$
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-3 border bg-light">
                                <span class="fw-bold text-secondary me-2">C.</span> $\{B, C\}$
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-3 border bg-light">
                                <span class="fw-bold text-secondary me-2">D.</span> $\{C, D\}$
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center justify-content-between pt-3 border-top gap-2">
                        <div class="text-muted small">
                            <i class="fa-solid fa-clock text-secondary me-1"></i> Chờ duyệt: 2 giờ trước
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-danger fw-semibold px-3 rounded-pill" data-bs-toggle="modal" data-bs-target="#rejectModal">
                                <i class="fa-solid fa-xmark me-1"></i> Từ chối
                            </button>
                            <button type="button" class="btn btn-outline-warning fw-semibold px-3 rounded-pill text-dark" data-bs-toggle="modal" data-bs-target="#reviseModal">
                                <i class="fa-solid fa-rotate-left me-1"></i> Yêu cầu sửa đổi
                            </button>
                            <button type="button" class="btn btn-success fw-semibold px-4 rounded-pill shadow-sm" onclick="alert('Đã phê duyệt Cấp 1 thành công! Câu hỏi được chuyển lên Phòng Khảo thí.')">
                                <i class="fa-solid fa-check me-1"></i> Phê duyệt Cấp 1
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Yêu cầu sửa đổi (Bắt buộc nhập lý do) -->
<div class="modal fade" id="reviseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-warning-emphasis">
                    <i class="fa-solid fa-triangle-exclamation text-warning me-2"></i> Yêu cầu Giảng viên Chỉnh sửa
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="text-muted small">
                    Theo quy định nghiệp vụ, khi yêu cầu sửa đổi, Trưởng bộ môn <strong>bắt buộc phải ghi rõ lý do hoặc góp ý cụ thể</strong> để Giảng viên cập nhật lại phiên bản mới.
                </p>
                <div class="mb-3">
                    <label class="form-label fw-semibold small text-dark">Nội dung góp ý / Lý do yêu cầu sửa (*):</label>
                    <textarea class="form-control" rows="4" placeholder="Ví dụ: Phương án B diễn đạt chưa rõ nghĩa, câu hỏi cần thêm giả thiết..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-warning rounded-pill px-4 fw-semibold text-dark" data-bs-dismiss="modal" onclick="alert('Đã gửi phản hồi yêu cầu chỉnh sửa đến Giảng viên!')">
                    Gửi yêu cầu sửa
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Từ chối câu hỏi -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="fa-solid fa-ban text-danger me-2"></i> Xác nhận Từ chối Câu hỏi
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="text-muted small">
                    Câu hỏi bị từ chối sẽ bị hủy bỏ khỏi đợt gửi duyệt này và không thể đưa vào Ngân hàng chính thức.
                </p>
                <div class="mb-3">
                    <label class="form-label fw-semibold small text-dark">Lý do từ chối (*):</label>
                    <textarea class="form-control" rows="3" placeholder="Nhập lý do từ chối câu hỏi..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 fw-semibold" data-bs-dismiss="modal" onclick="alert('Đã từ chối câu hỏi!')">
                    Xác nhận từ chối
                </button>
            </div>
        </div>
    </div>
</div>

