@{
    ViewData["Title"] = "Bàn làm việc Trưởng Bộ Môn - ExamBank";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Top Header Navbar (Header Height: 60-72px, Border: #E5E7EB) -->
<div class="px-4 py-3 bg-white border-bottom d-flex align-items-center justify-content-between shadow-sm top-header-navbar">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-light p-2 rounded-3 border sidebar-toggle-btn me-1" type="button" title="Thu gọn / Mở rộng menu (Ctrl + B)">
            <i class="fa-solid fa-bars text-secondary"></i>
        </button>
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="DepartmentHead" asp-action="Index" class="text-decoration-none text-secondary">Trưởng bộ môn</a></li>
                    <li class="breadcrumb-item active fw-bold" style="color: #6366f1;" aria-current="page">Bàn làm việc (Dashboard)</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2 text-muted small">
                <span class="badge bg-indigo-subtle text-indigo px-2 py-1 rounded-pill" style="background-color: #e0e7ff; color: #4338ca; font-weight: 600;">
                    <i class="fa-solid fa-landmark me-1"></i> @ViewBag.Department
                </span>
                <span class="text-secondary">• @ViewBag.Faculty</span>
            </div>
        </div>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="d-flex align-items-center gap-2 px-3 py-1 bg-light rounded-pill border text-muted small">
            <i class="fa-regular fa-calendar-days text-primary"></i>
            <span id="liveClock">Thứ Sáu, 13/11/2026 - 10:30</span>
        </div>

        <!-- Nút Chuông Thông báo công việc cần duyệt -->
        <a asp-action="QuestionReviews" class="btn btn-light rounded-circle p-2 border position-relative" title="Câu hỏi & Đề thi cần duyệt">
            <i class="fa-regular fa-bell text-secondary"></i>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                15
            </span>
        </a>

        <!-- Avatar Trưởng bộ môn -->
        <div class="d-flex align-items-center gap-2 border-start ps-3">
            <img src="https://ui-avatars.com/api/?name=Tran+Thi+Mai&background=4f46e5&color=fff&bold=true"
                 alt="Avatar" class="rounded-circle shadow-sm" width="38" height="38" />
            <div class="d-none d-lg-block text-start">
                <div class="fw-bold fs-7 text-dark line-height-1">@ViewBag.FullName</div>
                <small class="fw-semibold fs-8" style="color: #6366f1;">Trưởng Bộ Môn</small>
            </div>
        </div>
    </div>
</div>

<!-- Main Content Area -->
<div class="p-4" style="background-color: #f8fafc; min-height: calc(100vh - 75px);">

    <!-- Banner Chào mừng & Thông báo duyệt Cấp 1 (Animation Fade In / Slide Up) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden animate-fade-in-up" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 60%, #4338ca 100%);">
        <div class="card-body p-4 text-white">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <span class="badge px-3 py-1 rounded-pill mb-2 text-uppercase fw-bold" style="background: rgba(255,255,255,0.18); font-size: 11px; letter-spacing: 0.5px;">
                        <i class="fa-solid fa-shield-halved me-1 text-warning"></i> Cổng Duyệt Học Thuật Cấp 1
                    </span>
                    <h3 class="fw-bold mb-1">Xin chào, @ViewBag.FullName! 👋</h3>
                    <p class="mb-0 text-white-50" style="font-size: 14.5px;">
                        Hiện tại có <strong class="text-warning">12 câu hỏi</strong> và <strong class="text-warning">3 đề thi</strong> mới do các Giảng viên nộp lên đang chờ Thầy/Cô thẩm định chuyên môn.
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="QuestionReviews" class="btn btn-warning fw-bold px-3 py-2 shadow-sm rounded-3 text-dark">
                        <i class="fa-solid fa-clipboard-check me-1"></i> Duyệt câu hỏi ngay
                    </a>
                    <a asp-action="ExamReviews" class="btn btn-outline-light fw-semibold px-3 py-2 rounded-3">
                        <i class="fa-solid fa-file-shield me-1"></i> Duyệt đề thi
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 Khối KPI Cards thống kê nhiệm vụ Trưởng bộ môn (Count Up & Hover Effects) -->
    <div class="row g-3 mb-4">
        <!-- 1. Câu hỏi chờ duyệt -->
        <div class="col-12 col-sm-6 col-xl-3 animate-fade-in-up delay-1">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Câu hỏi chờ duyệt Cấp 1</span>
                    <div class="rounded-3 p-2 bg-warning-subtle text-warning">
                        <i class="fa-solid fa-clipboard-question fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="fw-bold text-dark mb-0 count-up" data-countup="12">12</h2>
                    <span class="badge bg-danger-subtle text-danger small"><i class="fa-solid fa-clock"></i> 4 cần gấp</span>
                </div>
                <small class="text-muted mt-2 d-block">Từ 4 giảng viên trong bộ môn nộp</small>
            </div>
        </div>

        <!-- 2. Đề thi chờ duyệt -->
        <div class="col-12 col-sm-6 col-xl-3 animate-fade-in-up delay-2">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4" style="border-color: #6366f1 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Đề thi chờ thẩm định</span>
                    <div class="rounded-3 p-2" style="background-color: #e0e7ff; color: #4f46e5;">
                        <i class="fa-solid fa-file-shield fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="fw-bold text-dark mb-0 count-up" data-countup="3">3</h2>
                    <span class="badge small" style="background-color: #e0e7ff; color: #4f46e5;">Đợt thi Giữa kỳ</span>
                </div>
                <small class="text-muted mt-2 d-block">Cần duyệt trước 18/11/2026</small>
            </div>
        </div>

        <!-- 3. Tổng ngân hàng câu hỏi bộ môn -->
        <div class="col-12 col-sm-6 col-xl-3 animate-fade-in-up delay-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Ngân hàng câu hỏi bộ môn</span>
                    <div class="rounded-3 p-2 bg-success-subtle text-success">
                        <i class="fa-solid fa-database fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="fw-bold text-dark mb-0 count-up" data-countup="1,280">1,280</h2>
                    <span class="badge bg-success-subtle text-success small"><i class="fa-solid fa-check-double"></i> Đã duyệt</span>
                </div>
                <small class="text-muted mt-2 d-block">Phủ 5 môn học trực thuộc bộ môn</small>
            </div>
        </div>

        <!-- 4. Tỷ lệ duyệt đạt chuẩn -->
        <div class="col-12 col-sm-6 col-xl-3 animate-fade-in-up delay-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-info">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Tỷ lệ duyệt đạt chuẩn</span>
                    <div class="rounded-3 p-2 bg-info-subtle text-info">
                        <i class="fa-solid fa-chart-pie fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="fw-bold text-dark mb-0 count-up" data-countup="88.5%">88.5%</h2>
                    <span class="badge bg-warning-subtle text-warning small">11.5% yêu cầu sửa</span>
                </div>
                <small class="text-muted mt-2 d-block">Chỉ số chất lượng biên soạn tháng này</small>
            </div>
        </div>
    </div>

    <!-- 2 Biểu đồ Phân tích (Chart.js) -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ 1: Tiến độ duyệt tuần -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Hoạt động Thẩm định Chuyên môn (Tuần này)</h5>
                        <small class="text-muted">Thống kê số lượng câu hỏi qua các quyết định thẩm định</small>
                    </div>
                    <span class="badge px-3 py-2 rounded-pill fw-semibold" style="background-color: #e0e7ff; color: #4338ca;">
                        Học kỳ 1 - 2026
                    </span>
                </div>
                <div class="card-body px-4 pb-4">
                    <div style="height: 280px; position: relative;">
                        <canvas id="reviewActivityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Biểu đồ 2: Phân bố cấp độ nhận thức Bloom của Bộ môn -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h5 class="fw-bold text-dark mb-1">Cơ cấu độ khó Bloom</h5>
                    <small class="text-muted">Phân bố 1,280 câu hỏi ngân hàng</small>
                </div>
                <div class="card-body px-4 pb-4 d-flex flex-column align-items-center justify-content-center">
                    <div style="height: 220px; width: 100%; position: relative;">
                        <canvas id="bloomDistributionChart"></canvas>
                    </div>
                    <div class="d-flex justify-content-center gap-3 mt-3 small text-muted">
                        <span><i class="fa-solid fa-circle text-primary"></i> Nhận biết (35%)</span>
                        <span><i class="fa-solid fa-circle text-success"></i> Thông hiểu (40%)</span>
                        <span><i class="fa-solid fa-circle text-warning"></i> Vận dụng (20%)</span>
                        <span><i class="fa-solid fa-circle text-danger"></i> Vận dụng cao (5%)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng đợi câu hỏi cần duyệt & Tiến độ Giảng viên -->
    <div class="row g-4">
        <!-- Bảng hàng đợi duyệt Cấp 1 -->
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-3 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Hàng đợi Câu hỏi cần Duyệt Cấp 1</h5>
                        <small class="text-muted">Danh sách câu hỏi giảng viên vừa gửi duyệt gần đây</small>
                    </div>
                    <a asp-action="QuestionReviews" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                        Xem tất cả (12) <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-4">Mã / Nội dung câu hỏi</th>
                                    <th>Môn học</th>
                                    <th>Giảng viên</th>
                                    <th>Độ khó</th>
                                    <th class="text-end pe-4">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Câu 1 -->
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">#Q-1082</div>
                                        <div class="text-muted small text-truncate" style="max-width: 280px;">
                                            Khóa chính (Primary Key) trong mô hình dữ liệu quan hệ có đặc tính gì sau đây?
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">Cơ sở dữ liệu (IT3020)</span>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark small">ThS. Nguyễn Văn A</div>
                                        <small class="text-muted">10:15 - Hôm nay</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Thông hiểu</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="QuestionReviews" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                            <i class="fa-solid fa-magnifying-glass me-1"></i> Xem & Duyệt
                                        </a>
                                    </td>
                                </tr>

                                <!-- Câu 2 -->
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">#Q-1081</div>
                                        <div class="text-muted small text-truncate" style="max-width: 280px;">
                                            Cho lược đồ quan hệ R(A, B, C, D) với tập phụ thuộc hàm F = {A->B, B->C, C->D}. Tìm khóa?
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">Cơ sở dữ liệu nâng cao</span>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark small">TS. Lê Hoàng Nam</div>
                                        <small class="text-muted">08:40 - Hôm nay</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Vận dụng</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="QuestionReviews" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                            <i class="fa-solid fa-magnifying-glass me-1"></i> Xem & Duyệt
                                        </a>
                                    </td>
                                </tr>

                                <!-- Câu 3 -->
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">#Q-1079</div>
                                        <div class="text-muted small text-truncate" style="max-width: 280px;">
                                            Chỉ mục phân cụm (Clustered Index) khác với Non-clustered Index ở điểm cơ bản nào?
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">Hệ quản trị CSDL</span>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark small">ThS. Phạm Thu Trang</div>
                                        <small class="text-muted">Hôm qua</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Vận dụng cao</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="QuestionReviews" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                            <i class="fa-solid fa-magnifying-glass me-1"></i> Xem & Duyệt
                                        </a>
                                    </td>
                                </tr>

                                <!-- Câu 4 -->
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">#Q-1075</div>
                                        <div class="text-muted small text-truncate" style="max-width: 280px;">
                                            Cú pháp câu lệnh SQL nào dùng để hủy quyền truy cập của một User trên bảng?
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">An toàn & Bảo mật CSDL</span>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark small">ThS. Nguyễn Văn A</div>
                                        <small class="text-muted">Hôm qua</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Nhận biết</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="QuestionReviews" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                            <i class="fa-solid fa-magnifying-glass me-1"></i> Xem & Duyệt
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng Tiến độ nộp câu hỏi của Giảng viên -->
        <div class="col-12 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Tiến độ nộp câu hỏi của GV</h5>
                        <small class="text-muted">Chỉ tiêu: 50 câu/giảng viên/học kỳ</small>
                    </div>
                    <a asp-action="LecturerProgress" class="btn btn-sm btn-link text-decoration-none fw-semibold">
                        Chi tiết <i class="fa-solid fa-chevron-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body p-4">
                    <!-- GV 1 -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div>
                                <span class="fw-bold text-dark">TS. Lê Hoàng Nam</span>
                                <small class="text-muted d-block" style="font-size: 12px;">Cơ sở dữ liệu nâng cao</small>
                            </div>
                            <span class="badge bg-success-subtle text-success fw-bold">50 / 50 (100%)</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success" style="width: 100%"></div>
                        </div>
                    </div>

                    <!-- GV 2 -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div>
                                <span class="fw-bold text-dark">ThS. Nguyễn Văn A</span>
                                <small class="text-muted d-block" style="font-size: 12px;">Cơ sở dữ liệu (IT3020)</small>
                            </div>
                            <span class="badge bg-primary-subtle text-primary fw-bold">42 / 50 (84%)</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-primary" style="width: 84%"></div>
                        </div>
                    </div>

                    <!-- GV 3 -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div>
                                <span class="fw-bold text-dark">ThS. Phạm Thu Trang</span>
                                <small class="text-muted d-block" style="font-size: 12px;">Hệ quản trị CSDL</small>
                            </div>
                            <span class="badge bg-warning-subtle text-warning fw-bold">28 / 50 (56%)</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-warning" style="width: 56%"></div>
                        </div>
                    </div>

                    <!-- GV 4 -->
                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div>
                                <span class="fw-bold text-dark">ThS. Đỗ Minh Khang</span>
                                <small class="text-muted d-block" style="font-size: 12px;">Khai phá dữ liệu</small>
                            </div>
                            <span class="badge bg-danger-subtle text-danger fw-bold">15 / 50 (30%)</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-danger" style="width: 30%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 1. Biểu đồ Hoạt động Thẩm định trong tuần (Chart.js Bar Chart)
    const ctxReview = document.getElementById('reviewActivityChart').getContext('2d');
    new Chart(ctxReview, {
        type: 'bar',
        data: {
            labels: ['Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'],
            datasets: [
                {
                    label: 'Đã phê duyệt Cấp 1',
                    data: [15, 22, 18, 25, 20, 10],
                    backgroundColor: '#10b981',
                    borderRadius: 6
                },
                {
                    label: 'Yêu cầu sửa đổi (Trả về)',
                    data: [3, 2, 4, 1, 3, 0],
                    backgroundColor: '#f59e0b',
                    borderRadius: 6
                },
                {
                    label: 'Từ chối',
                    data: [1, 0, 1, 0, 0, 0],
                    backgroundColor: '#ef4444',
                    borderRadius: 6
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'top',
                    labels: { boxWidth: 12, font: { family: "'Segoe UI', sans-serif", size: 12 } }
                }
            },
            scales: {
                y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                x: { grid: { display: false } }
            }
        }
    });

    // 2. Biểu đồ Phân bổ cấp độ nhận thức Bloom (Doughnut Chart)
    const ctxBloom = document.getElementById('bloomDistributionChart').getContext('2d');
    new Chart(ctxBloom, {
        type: 'doughnut',
        data: {
            labels: ['Nhận biết', 'Thông hiểu', 'Vận dụng', 'Vận dụng cao'],
            datasets: [{
                data: [35, 40, 20, 5],
