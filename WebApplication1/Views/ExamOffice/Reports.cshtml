@{
    ViewData["Title"] = "Báo cáo Khảo thí & Thống kê Đề thi - ExamBank";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Top Header Navbar -->
<div class="px-4 py-3 bg-white border-bottom d-flex align-items-center justify-content-between shadow-sm">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="ExamOffice" asp-action="Index" class="text-decoration-none text-secondary">Khảo thí & ĐBCL</a></li>
            <li class="breadcrumb-item active fw-bold" style="color: #e11d48;" aria-current="page">Báo cáo & Thống kê Khảo thí</li>
        </ol>
    </nav>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-outline-danger px-3 py-2 rounded-pill fw-bold" onclick="alert('Đang kết xuất báo cáo tổng kết kỳ thi ra file Excel...');">
            <i class="fa-solid fa-file-excel me-1"></i> Xuất Báo cáo Excel
        </button>
        <button class="btn btn-sm text-white px-3 py-2 rounded-pill fw-bold" style="background-color: #e11d48;" onclick="alert('Đang tải file PDF Báo cáo kiểm định chất lượng khảo thí...');">
            <i class="fa-solid fa-file-pdf me-1"></i> Xuất PDF có dấu
        </button>
    </div>
</div>

<div class="p-4" style="background-color: #f8fafc; min-height: calc(100vh - 75px);">
    <!-- KPI Header Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Tổng đề thi đã phát hành</div>
                        <h4 class="fw-bold text-dark mt-1 mb-0">128 bộ</h4>
                        <small class="text-success fw-bold"><i class="fa-solid fa-arrow-up"></i> 100% qua 2 cấp duyệt</small>
                    </div>
                    <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #e11d48, #be123c);">
                        <i class="fa-solid fa-file-circle-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Tỷ lệ duyệt đúng hạn</div>
                        <h4 class="fw-bold text-dark mt-1 mb-0">96.8%</h4>
                        <small class="text-success fw-bold">SLA dưới 48 giờ</small>
                    </div>
                    <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #059669, #10b981);">
                        <i class="fa-solid fa-stopwatch fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Tổng bản in an toàn</div>
                        <h4 class="fw-bold text-dark mt-1 mb-0">14.650 bản</h4>
                        <small class="text-muted">Có mã vạch & Watermark</small>
                    </div>
                    <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #2563eb, #1d4ed8);">
                        <i class="fa-solid fa-print fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Sự cố an ninh đề thi</div>
                        <h4 class="fw-bold text-success mt-1 mb-0">0 vụ</h4>
                        <small class="text-success fw-bold"><i class="fa-solid fa-shield-check"></i> Tuyệt đối an toàn</small>
                    </div>
                    <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #0d9488, #14b8a6);">
                        <i class="fa-solid fa-shield-halved fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng phân tích chi tiết tiến độ theo Khoa -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 px-4 border-bottom">
            <h5 class="fw-bold text-dark mb-0">
                <i class="fa-solid fa-chart-pie me-2" style="color: #e11d48;"></i>
                Thống kê Tiến độ Thẩm định & Phát hành Đề thi theo Khoa / Viện
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Khoa / Viện</th>
                        <th>Tổng môn thi</th>
                        <th>Đề đã duyệt Cấp 1</th>
                        <th>Đã phê duyệt Cấp 2</th>
                        <th>Đã phát hành & In ấn</th>
                        <th>Tỷ lệ hoàn thành</th>
                        <th class="text-end pe-4">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4 fw-bold text-dark">Khoa Công nghệ Thông tin</td>
                        <td>24 môn</td>
                        <td>24/24</td>
                        <td>24/24</td>
                        <td>24/24</td>
                        <td style="width: 200px;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar bg-success" style="width: 100%;"></div>
                                </div>
                                <small class="fw-bold text-success">100%</small>
                            </div>
                        </td>
                        <td class="text-end pe-4"><span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill">Đã hoàn tất</span></td>
                    </tr>
                    <tr>
                        <td class="ps-4 fw-bold text-dark">Khoa Kinh tế & Quản trị Kinh doanh</td>
                        <td>18 môn</td>
                        <td>18/18</td>
                        <td>17/18</td>
                        <td>16/18</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar bg-primary" style="width: 88%;"></div>
                                </div>
                                <small class="fw-bold text-primary">88%</small>
                            </div>
                        </td>
                        <td class="text-end pe-4"><span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill">Đang xử lý</span></td>
                    </tr>
                    <tr>
                        <td class="ps-4 fw-bold text-dark">Khoa Ngoại ngữ</td>
                        <td>12 môn</td>
                        <td>12/12</td>
                        <td>12/12</td>
                        <td>11/12</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar bg-info" style="width: 92%;"></div>
                                </div>
                                <small class="fw-bold text-info">92%</small>
                            </div>
                        </td>
                        <td class="text-end pe-4"><span class="badge bg-info-subtle text-info px-3 py-1 rounded-pill">Đang in ấn</span></td>
                    </tr>
                    <tr>
                        <td class="ps-4 fw-bold text-dark">Khoa Khoa học Cơ bản</td>
                        <td>10 môn</td>
                        <td>9/10</td>
                        <td>8/10</td>
                        <td>6/10</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar bg-warning" style="width: 60%;"></div>
                                </div>
                                <small class="fw-bold text-warning">60%</small>
                            </div>
                        </td>
                        <td class="text-end pe-4"><span class="badge bg-warning-subtle text-warning px-3 py-1 rounded-pill">Cần đôn đốc</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

