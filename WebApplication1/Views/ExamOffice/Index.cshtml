@{
    ViewData["Title"] = "Bàn làm việc Phòng Khảo Thí - ExamBank";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Top Header Navbar (Header Height: 60-72px, Border: #E5E7EB) -->
<div class="px-4 py-3 bg-white border-bottom d-flex align-items-center justify-content-between shadow-sm top-header-navbar">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-light p-2 rounded-3 border sidebar-toggle-btn me-1" type="button" title="Thu gọn / Mở rộng menu (Ctrl + B)">
            <i class="fa-solid fa-bars text-secondary"></i>
        </button>
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="ExamOffice" asp-action="Index" class="text-decoration-none text-secondary">Khảo thí & ĐBCL</a></li>
                    <li class="breadcrumb-item active fw-bold" style="color: #e11d48;" aria-current="page">Bàn làm việc (Dashboard)</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2 text-muted small">
                <span class="badge px-2 py-1 rounded-pill" style="background-color: #ffe4e6; color: #be123c; font-weight: 600;">
                    <i class="fa-solid fa-stamp me-1"></i> @ViewBag.Department
                </span>
                <span class="text-secondary">• @ViewBag.Institution</span>
            </div>
        </div>
    </div>
    <div class="d-flex align-items-center gap-3">
        <div class="d-flex align-items-center gap-2 px-3 py-1 bg-light rounded-pill border text-muted small">
            <i class="fa-regular fa-calendar-days text-danger"></i>
            <span id="liveClock">Thứ Sáu, 13/11/2026 - 11:00</span>
        </div>

        <!-- Chuông thông báo đợt in & đề thi cần phát hành -->
        <a asp-action="ExamReviews" class="btn btn-light rounded-circle p-2 border position-relative" title="Đề thi & Câu hỏi cần duyệt Cấp 2">
            <i class="fa-regular fa-bell text-secondary"></i>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                23
            </span>
        </a>

        <!-- Avatar Chuyên viên Khảo thí -->
        <div class="d-flex align-items-center gap-2 border-start ps-3">
            <img src="https://ui-avatars.com/api/?name=Hoang+Thi+Lan&background=e11d48&color=fff&bold=true"
                 alt="Avatar" class="rounded-circle shadow-sm" width="38" height="38" />
            <div class="d-none d-lg-block text-start">
                <div class="fw-bold fs-7 text-dark line-height-1">@ViewBag.FullName</div>
                <small class="fw-semibold fs-8" style="color: #e11d48;">Chuyên viên Khảo thí & ĐBCL</small>
            </div>
        </div>
    </div>
</div>

<!-- Main Content Area -->
<div class="p-4" style="background-color: #f8fafc; min-height: calc(100vh - 75px);">

    <!-- Banner Chào mừng & Quyền hạn Thẩm định Cấp 2 (Animation Fade In / Slide Up) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden animate-fade-in-up" style="background: linear-gradient(135deg, #4c0519 0%, #881337 55%, #be123c 100%);">
        <div class="card-body p-4 text-white">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <span class="badge px-3 py-1 rounded-pill mb-2 text-uppercase fw-bold" style="background: rgba(255,255,255,0.2); font-size: 11px; letter-spacing: 0.5px;">
                        <i class="fa-solid fa-stamp me-1 text-warning"></i> Thẩm Định Cấp 2 & Quản Lý Phát Hành Đề Thi
                    </span>
                    <h3 class="fw-bold mb-1">Xin chào, @ViewBag.FullName! 👋</h3>
                    <p class="mb-0 text-white-50" style="font-size: 14.5px;">
                        Hệ thống ghi nhận <strong class="text-warning">18 câu hỏi</strong> đã qua Trưởng bộ môn duyệt và <strong class="text-warning">5 bộ đề thi</strong> đang chờ Phòng Khảo thí cấp phép Phát hành (`Published`).
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="ExamReviews" class="btn btn-warning fw-bold px-3 py-2 shadow-sm rounded-3 text-dark">
                        <i class="fa-solid fa-file-shield me-1"></i> Duyệt Đề Cấp 2
                    </a>
                    <a asp-action="PrintBatches" class="btn btn-outline-light fw-semibold px-3 py-2 rounded-3">
                        <i class="fa-solid fa-print me-1"></i> Quản lý Đợt in
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 Khối KPI Cards thống kê khảo thí (Count Up & Hover Effects) -->
    <div class="row g-3 mb-4">
        <!-- 1. Câu hỏi chờ duyệt Cấp 2 -->
        <div class="col-12 col-sm-6 col-xl-3 animate-fade-in-up delay-1">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-danger">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Câu hỏi chờ duyệt Cấp 2</span>
                    <div class="rounded-3 p-2 bg-danger-subtle text-danger">
                        <i class="fa-solid fa-stamp fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="fw-bold text-dark mb-0 count-up" data-countup="18">18</h2>
                    <span class="badge bg-danger-subtle text-danger small"><i class="fa-solid fa-check"></i> Đã qua Cấp 1</span>
                </div>
                <small class="text-muted mt-2 d-block">Chờ cấp trạng thái `Approved`</small>
            </div>
        </div>

        <!-- 2. Đề thi chờ phát hành -->
        <div class="col-12 col-sm-6 col-xl-3 animate-fade-in-up delay-2">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Đề thi chờ Phát hành</span>
                    <div class="rounded-3 p-2 bg-warning-subtle text-warning">
                        <i class="fa-solid fa-file-circle-check fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="fw-bold text-dark mb-0 count-up" data-countup="5">5</h2>
                    <span class="badge bg-warning-subtle text-warning small">Kỳ thi Học kỳ 1</span>
                </div>
                <small class="text-muted mt-2 d-block">Cần duyệt trước khi tạo đợt in</small>
            </div>
        </div>

        <!-- 3. Đợt in ấn đang xử lý -->
        <div class="col-12 col-sm-6 col-xl-3 animate-fade-in-up delay-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-info">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Đợt in đang xử lý</span>
                    <div class="rounded-3 p-2 bg-info-subtle text-info">
                        <i class="fa-solid fa-print fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="fw-bold text-dark mb-0 count-up" data-countup="2">2</h2>
                    <span class="badge bg-info-subtle text-info small">1,200 bản đề</span>
                </div>
                <small class="text-muted mt-2 d-block">Niêm phong & bàn giao điểm thi</small>
            </div>
        </div>

        <!-- 4. Ngân hàng toàn trường -->
        <div class="col-12 col-sm-6 col-xl-3 animate-fade-in-up delay-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Ngân hàng chính thức (Approved)</span>
                    <div class="rounded-3 p-2 bg-success-subtle text-success">
                        <i class="fa-solid fa-building-columns fs-5"></i>
                    </div>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <h2 class="fw-bold text-dark mb-0 count-up" data-countup="6,450">6,450</h2>
                    <span class="badge bg-success-subtle text-success small">Toàn trường</span>
                </div>
                <small class="text-muted mt-2 d-block">Sẵn sàng sinh đề ngẫu nhiên</small>
            </div>
        </div>
    </div>

    <!-- 2 Biểu đồ Phân tích Khảo thí (Chart.js) -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ 1: Thống kê duyệt câu hỏi & đề thi theo Khoa -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Số lượng Câu hỏi đã Approved theo Khoa/Viện</h5>
                        <small class="text-muted">Đảm bảo chất lượng dữ liệu đề thi trên toàn học viện</small>
                    </div>
                    <span class="badge px-3 py-2 rounded-pill fw-semibold bg-danger-subtle text-danger">
                        Học kỳ 1 - 2026
                    </span>
                </div>
                <div class="card-body px-4 pb-4">
                    <div style="height: 280px; position: relative;">
                        <canvas id="facultyQuestionsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Biểu đồ 2: Tình trạng tiến độ in ấn đề thi -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h5 class="fw-bold text-dark mb-1">Tiến độ In & Phát hành Đề thi</h5>
                    <small class="text-muted">Tổng 12 môn thi trong đợt</small>
                </div>
                <div class="card-body px-4 pb-4 d-flex flex-column align-items-center justify-content-center">
                    <div style="height: 220px; width: 100%; position: relative;">
                        <canvas id="examPrintStatusChart"></canvas>
                    </div>
                    <div class="d-flex flex-wrap justify-content-center gap-3 mt-3 small text-muted">
                        <span><i class="fa-solid fa-circle text-success"></i> Đã bàn giao (65%)</span>
                        <span><i class="fa-solid fa-circle text-info"></i> Đang in ấn (20%)</span>
                        <span><i class="fa-solid fa-circle text-warning"></i> Chờ duyệt (15%)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng đợi Đề thi cần Duyệt Cấp 2 & Đợt in ấn -->
    <div class="row g-4">
        <!-- Bảng Đề thi chờ Khảo thí Duyệt Cấp 2 -->
        <div class="col-12 col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-3 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Hàng đợi Đề thi chờ Thẩm định Cấp 2</h5>
                        <small class="text-muted">Đã qua Trưởng bộ môn phê duyệt Cấp 1, chờ Khảo thí cấp phép Phát hành</small>
                    </div>
                    <a asp-action="ExamReviews" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
                        Xem tất cả (5) <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-muted small text-uppercase">
                                <tr>
                                    <th class="ps-4">Mã / Tên đề thi</th>
                                    <th>Khoa / Bộ môn</th>
                                    <th>Duyệt Cấp 1</th>
                                    <th>Số mã đề</th>
                                    <th class="text-end pe-4">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">#EXAM-2026-01</div>
                                        <div class="text-muted small">Cơ sở dữ liệu nâng cao (IT3020)</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">Khoa CNTT</span>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-success"><i class="fa-solid fa-check-circle me-1"></i> PGS.TS. Trần Thị Mai</div>
                                        <small class="text-muted">Duyệt ngày 13/11</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary">4 mã đề con</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="ExamReviews" class="btn btn-sm btn-danger rounded-pill px-3 fw-semibold" style="background-color: #be123c; border-color: #be123c;">
                                            <i class="fa-solid fa-stamp me-1"></i> Thẩm định Cấp 2
                                        </a>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">#EXAM-2026-02</div>
                                        <div class="text-muted small">Lập trình Mạng & Phân tán (IT4010)</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">Khoa CNTT</span>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-success"><i class="fa-solid fa-check-circle me-1"></i> TS. Nguyễn Hoàng Hải</div>
                                        <small class="text-muted">Duyệt ngày 12/11</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary">4 mã đề con</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="ExamReviews" class="btn btn-sm btn-danger rounded-pill px-3 fw-semibold" style="background-color: #be123c; border-color: #be123c;">
                                            <i class="fa-solid fa-stamp me-1"></i> Thẩm định Cấp 2
                                        </a>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">#EXAM-2026-03</div>
                                        <div class="text-muted small">Toán Rời rạc & Lý thuyết Đồ thị (MA2010)</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">Khoa Toán - Tin</span>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-success"><i class="fa-solid fa-check-circle me-1"></i> PGS.TS. Lê Văn Thắng</div>
                                        <small class="text-muted">Duyệt ngày 12/11</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary">6 mã đề con</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="ExamReviews" class="btn btn-sm btn-danger rounded-pill px-3 fw-semibold" style="background-color: #be123c; border-color: #be123c;">
                                            <i class="fa-solid fa-stamp me-1"></i> Thẩm định Cấp 2
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng Quản lý Đợt in ấn Đề thi Niêm phong -->
        <div class="col-12 col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2 d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">Đợt in đề thi niêm phong</h5>
                        <small class="text-muted">Theo dõi quy trình in ấn & bàn giao</small>
                    </div>
                    <a asp-action="PrintBatches" class="btn btn-sm btn-link text-decoration-none text-danger fw-semibold">
                        Chi tiết <i class="fa-solid fa-chevron-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body p-4">
                    <!-- Batch 1 -->
                    <div class="p-3 rounded-3 bg-light border mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-dark">#PRINT-089</span>
                            <span class="badge bg-warning-subtle text-warning">Đang in ấn</span>
                        </div>
                        <div class="text-dark small fw-medium">Cơ sở dữ liệu nâng cao (IT3020)</div>
                        <small class="text-muted d-block mb-2">Số lượng: 650 bản (4 mã đề: 101, 102, 103, 104)</small>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-warning" style="width: 70%"></div>
                        </div>
                    </div>

                    <!-- Batch 2 -->
                    <div class="p-3 rounded-3 bg-light border mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-dark">#PRINT-088</span>
                            <span class="badge bg-success-subtle text-success">Đã bàn giao</span>
                        </div>
                        <div class="text-dark small fw-medium">Kỹ thuật Lập trình C/C++</div>
                        <small class="text-muted d-block mb-2">Số lượng: 800 bản • Đã niêm phong tủ bảo mật</small>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-success" style="width: 100%"></div>
                        </div>
                    </div>

                    <!-- Batch 3 -->
                    <div class="p-3 rounded-3 bg-light border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold text-dark">#PRINT-087</span>
                            <span class="badge bg-secondary-subtle text-secondary">Chờ chuẩn bị giấy</span>
                        </div>
                        <div class="text-dark small fw-medium">Kiến trúc Máy tính (IT2020)</div>
                        <small class="text-muted d-block">Số lượng: 450 bản • Dự kiến in 14/11</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 1. Biểu đồ Số lượng Câu hỏi đã Approved theo Khoa (Chart.js Bar Chart)
    const ctxFaculty = document.getElementById('facultyQuestionsChart').getContext('2d');
    new Chart(ctxFaculty, {
        type: 'bar',
        data: {
            labels: ['Khoa CNTT', 'Khoa Điện tử', 'Khoa Toán - Tin', 'Khoa Cơ khí', 'Khoa Kinh tế số'],
            datasets: [
                {
                    label: 'Đã duyệt vào Ngân hàng (Approved)',
                    data: [2150, 1420, 1180, 950, 750],
                    backgroundColor: '#e11d48',
                    borderRadius: 6
                },
                {
                    label: 'Đang chờ thẩm định Cấp 2',
                    data: [18, 12, 15, 8, 5],
                    backgroundColor: '#f59e0b',
                    borderRadius: 6
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'top',
                    labels: { boxWidth: 12, font: { family: "'Segoe UI', sans-serif", size: 12 } }
                }
            },
            scales: {
                y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                x: { grid: { display: false } }
            }
        }
    });

    // 2. Biểu đồ Tình trạng In ấn & Phát hành (Chart.js Doughnut Chart)
    const ctxPrint = document.getElementById('examPrintStatusChart').getContext('2d');
    new Chart(ctxPrint, {
        type: 'doughnut',
        data: {
            labels: ['Đã bàn giao', 'Đang in ấn', 'Chờ duyệt'],
            datasets: [{
                data: [65, 20, 15],
                backgroundColor: ['#10b981', '#06b6d4', '#f59e0b'],
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '72%',
            plugins: {
                legend: { display: false }
            }
        }
    });
</script>
}

