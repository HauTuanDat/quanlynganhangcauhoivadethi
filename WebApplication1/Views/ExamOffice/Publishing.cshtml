@{
    ViewData["Title"] = "Phát hành đề thi & Xuất tài liệu bảo mật - ExamBank";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Top Header Navbar -->
<div class="px-4 py-3 bg-white border-bottom d-flex align-items-center justify-content-between shadow-sm">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="ExamOffice" asp-action="Index" class="text-decoration-none text-secondary">Khảo thí & ĐBCL</a></li>
            <li class="breadcrumb-item active fw-bold" style="color: #e11d48;" aria-current="page">Phát hành & Xuất đề thi bảo mật</li>
        </ol>
    </nav>
    <div class="d-flex align-items-center gap-2">
        <span class="badge px-3 py-2 rounded-pill fw-bold" style="background-color: #ffe4e6; color: #be123c;">
            <i class="fa-solid fa-lock me-1"></i> Chế độ Bảo mật Cấp 2
        </span>
    </div>
</div>

<div class="p-4" style="background-color: #f8fafc; min-height: calc(100vh - 75px);">

    <!-- Khung Hướng dẫn Quy chế Bảo mật Đề thi -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" style="background: linear-gradient(135deg, #1e1b4b 0%, #312e81 60%, #4c0519 100%);">
        <div class="card-body p-4 text-white">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <span class="badge px-3 py-1 rounded-pill mb-2 text-uppercase fw-bold" style="background: rgba(255,255,255,0.2); font-size: 11px;">
                        <i class="fa-solid fa-shield-halved me-1 text-warning"></i> Quy chế Bảo mật Đề thi Ban hành
                    </span>
                    <h4 class="fw-bold mb-1">Quản lý Phát hành & Lựa chọn Đề thi Chính thức</h4>
                    <p class="mb-0 text-white-50 small" style="max-width: 800px;">
                        Đề thi sau khi bấm <strong>"Cấp phép Phát hành"</strong> sẽ được khóa cứng snapshot. Mọi thao tác xuất file Word/PDF đề thi và đáp án đều được ghi vào Audit Log kèm mã định danh người tải.
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-warning fw-bold px-3 py-2 rounded-3 text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#chooseOfficialExamModal">
                        <i class="fa-solid fa-check-double me-1"></i> Quyết định Đề Chính thức
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bộ lọc & Thống kê phát hành -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Tìm theo mã đề, tên môn học, học kỳ..." />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select class="form-select">
                        <option value="">Tất cả đợt thi</option>
                        <option value="gk1" selected>Kỳ thi Giữa kỳ - Học kỳ 1 (2026-2027)</option>
                        <option value="ck1">Kỳ thi Cuối kỳ - Học kỳ 1 (2026-2027)</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <select class="form-select">
                        <option value="">Tất cả loại đề</option>
                        <option value="official">Đề thi Chính thức</option>
                        <option value="backup">Đề thi Dự bị (Dự phòng)</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <button class="btn btn-danger w-100 fw-semibold rounded-3" style="background-color: #be123c; border-color: #be123c;">
                        <i class="fa-solid fa-filter me-1"></i> Lọc đề thi
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách Đề thi đã Được phép Phát hành -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold text-dark mb-0">Danh sách Đề thi đã Phê duyệt Phát hành (`Published`)</h5>
                <small class="text-muted">Đã kiểm duyệt đủ 2 cấp (Trưởng bộ môn & Phòng Khảo thí)</small>
            </div>
            <a asp-action="PrintBatches" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
                <i class="fa-solid fa-print me-1"></i> Chuyển sang Tạo đợt in
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">Mã bộ đề</th>
                        <th>Học phần / Môn học</th>
                        <th>Loại chỉ định</th>
                        <th>Số mã đề con</th>
                        <th>Thời gian & Câu</th>
                        <th>Trạng thái phát hành</th>
                        <th class="text-end pe-4">Xuất tài liệu bảo mật</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Đề 1: Đề chính thức -->
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-danger fw-bold" style="background-color: #be123c !important;">#EXAM-2026-01</span>
                            <small class="d-block text-muted mt-1">Snapshot v1.2</small>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">Cơ sở dữ liệu nâng cao (IT3020)</div>
                            <small class="text-muted">Khoa Công nghệ Thông tin • Kỳ thi Giữa kỳ</small>
                        </td>
                        <td>
                            <span class="badge bg-danger text-white px-2 py-1 rounded-pill fw-bold">
                                <i class="fa-solid fa-star me-1"></i> ĐỀ CHÍNH THỨC
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <span class="badge bg-light text-dark border">Mã 101</span>
                                <span class="badge bg-light text-dark border">Mã 102</span>
                                <span class="badge bg-light text-dark border">Mã 103</span>
                                <span class="badge bg-light text-dark border">Mã 104</span>
                            </div>
                        </td>
                        <td>
                            <div class="small fw-semibold text-dark">60 phút • 40 câu</div>
                            <small class="text-success"><i class="fa-solid fa-shield-check"></i> 0% trùng câu</small>
                        </td>
                        <td>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                <i class="fa-solid fa-check-circle me-1"></i> Đã Published
                            </span>
                            <small class="d-block text-muted" style="font-size: 11px;">13/11/2026 bởi LanHT</small>
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-start-pill px-3" data-bs-toggle="modal" data-bs-target="#examPreviewModal">
                                    <i class="fa-solid fa-eye me-1"></i> Xem trước
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="alert('Đang xuất bản Word đề thi (Mã 101-104) cho sinh viên...')">
                                    <i class="fa-solid fa-file-word me-1"></i> Word
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="alert('Đang tạo bản in PDF kèm tem chống sao chép...')">
                                    <i class="fa-solid fa-file-pdf me-1"></i> PDF
                                </button>
                                <button type="button" class="btn btn-sm btn-dark rounded-end-pill px-3" data-bs-toggle="modal" data-bs-target="#answerKeySecurityModal">
                                    <i class="fa-solid fa-key text-warning me-1"></i> Đáp án
                                </button>
                            </div>
                        </td>
                    </tr>

                    <!-- Đề 2: Đề dự bị -->
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-secondary fw-bold">#EXAM-2026-02</span>
                            <small class="d-block text-muted mt-1">Snapshot v1.0</small>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">Cơ sở dữ liệu nâng cao (IT3020)</div>
                            <small class="text-muted">Khoa Công nghệ Thông tin • Kỳ thi Giữa kỳ</small>
                        </td>
                        <td>
                            <span class="badge bg-secondary text-white px-2 py-1 rounded-pill fw-bold">
                                <i class="fa-solid fa-shield me-1"></i> ĐỀ DỰ BỊ (DỰ PHÒNG)
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <span class="badge bg-light text-dark border">Mã 201</span>
                                <span class="badge bg-light text-dark border">Mã 202</span>
                                <span class="badge bg-light text-dark border">Mã 203</span>
                                <span class="badge bg-light text-dark border">Mã 204</span>
                            </div>
                        </td>
                        <td>
                            <div class="small fw-semibold text-dark">60 phút • 40 câu</div>
                            <small class="text-success"><i class="fa-solid fa-shield-check"></i> 0% trùng câu</small>
                        </td>
                        <td>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                <i class="fa-solid fa-check-circle me-1"></i> Đã Published
                            </span>
                            <small class="d-block text-muted" style="font-size: 11px;">13/11/2026 bởi LanHT</small>
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-start-pill px-3" data-bs-toggle="modal" data-bs-target="#examPreviewModal">
                                    <i class="fa-solid fa-eye me-1"></i> Xem trước
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="alert('Đang xuất bản Word đề thi dự bị...')">
                                    <i class="fa-solid fa-file-word me-1"></i> Word
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="alert('Đang tạo bản PDF đề thi dự bị...')">
                                    <i class="fa-solid fa-file-pdf me-1"></i> PDF
                                </button>
                                <button type="button" class="btn btn-sm btn-dark rounded-end-pill px-3" data-bs-toggle="modal" data-bs-target="#answerKeySecurityModal">
                                    <i class="fa-solid fa-key text-warning me-1"></i> Đáp án
                                </button>
                            </div>
                        </td>
                    </tr>

                    <!-- Đề 3: Lập trình mạng -->
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-danger fw-bold" style="background-color: #be123c !important;">#EXAM-2026-03</span>
                            <small class="d-block text-muted mt-1">Snapshot v1.1</small>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">Lập trình Mạng & Phân tán (IT4010)</div>
                            <small class="text-muted">Khoa Công nghệ Thông tin • Kỳ thi Giữa kỳ</small>
                        </td>
                        <td>
                            <span class="badge bg-danger text-white px-2 py-1 rounded-pill fw-bold">
                                <i class="fa-solid fa-star me-1"></i> ĐỀ CHÍNH THỨC
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <span class="badge bg-light text-dark border">Mã 301</span>
                                <span class="badge bg-light text-dark border">Mã 302</span>
                                <span class="badge bg-light text-dark border">Mã 303</span>
                                <span class="badge bg-light text-dark border">Mã 304</span>
                            </div>
                        </td>
                        <td>
                            <div class="small fw-semibold text-dark">50 phút • 35 câu</div>
                            <small class="text-success"><i class="fa-solid fa-shield-check"></i> 0% trùng câu</small>
                        </td>
                        <td>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                <i class="fa-solid fa-check-circle me-1"></i> Đã Published
                            </span>
                            <small class="d-block text-muted" style="font-size: 11px;">12/11/2026 bởi LanHT</small>
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-start-pill px-3" data-bs-toggle="modal" data-bs-target="#examPreviewModal">
                                    <i class="fa-solid fa-eye me-1"></i> Xem trước
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="alert('Đang tải file Word...')">
                                    <i class="fa-solid fa-file-word me-1"></i> Word
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="alert('Đang tải file PDF...')">
                                    <i class="fa-solid fa-file-pdf me-1"></i> PDF
                                </button>
                                <button type="button" class="btn btn-sm btn-dark rounded-end-pill px-3" data-bs-toggle="modal" data-bs-target="#answerKeySecurityModal">
                                    <i class="fa-solid fa-key text-warning me-1"></i> Đáp án
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal 1: Quyết định lựa chọn Đề chính thức vs Đề dự phòng -->
<div class="modal fade" id="chooseOfficialExamModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="fa-solid fa-scale-balanced text-danger me-2"></i> Quyết định Chỉ định Đề thi Chính thức
                    </h5>
                    <small class="text-muted">Chọn bộ đề thi áp dụng chính thức cho phòng thi của sinh viên</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark small">1. Chọn Học phần / Môn học:</label>
                    <select class="form-select">
                        <option selected>Cơ sở dữ liệu nâng cao (IT3020) - 2 bộ đề đã duyệt</option>
                        <option>Lập trình Mạng & Phân tán (IT4010) - 1 bộ đề đã duyệt</option>
                    </select>
                </div>

                <label class="form-label fw-bold text-dark small mb-2">2. Lựa chọn vai trò từng bộ đề:</label>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-4 border border-danger bg-danger-subtle h-100">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="officialRadio" id="optExam1" checked />
                                <label class="form-check-label fw-bold text-dark" for="optExam1">
                                    #EXAM-2026-01: Bộ đề A (TS. Lê Hoàng Nam)
                                </label>
                            </div>
                            <div class="ps-4 mt-2 small text-muted">
                                <div>• 4 mã đề: 101, 102, 103, 104</div>
                                <div>• Ma trận: 40 câu • Đã thẩm định Cấp 2</div>
                                <span class="badge bg-danger mt-2">CHỈ ĐỊNH: ĐỀ THI CHÍNH THỨC</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-4 border h-100 bg-white">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="officialRadio" id="optExam2" />
                                <label class="form-check-label fw-bold text-dark" for="optExam2">
                                    #EXAM-2026-02: Bộ đề B (ThS. Nguyễn Văn A)
                                </label>
                            </div>
                            <div class="ps-4 mt-2 small text-muted">
                                <div>• 4 mã đề: 201, 202, 203, 204</div>
                                <div>• Ma trận: 40 câu • Đã thẩm định Cấp 2</div>
                                <span class="badge bg-secondary mt-2">CHỈ ĐỊNH: ĐỀ THI DỰ BỊ</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-warning border-0 rounded-3 mt-3 mb-0 small">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> Quyết định này sẽ xác lập mã đề in ấn chính thức trong lệnh in tiếp theo.
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 fw-semibold" style="background-color: #be123c; border-color: #be123c;" data-bs-dismiss="modal" onclick="alert('Đã cập nhật chỉ định Đề thi Chính thức thành công!')">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Quyết định
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 2: Xác thực Bảo mật khi Mở Phiếu Đáp án (Answer Key Matrix Security) -->
<div class="modal fade" id="answerKeySecurityModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="fa-solid fa-shield-cat text-danger me-2"></i> Xác thực Quyền Xem / Tải Đáp án
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="text-muted small">
                    Theo quy định bảo mật khảo thí, Phiếu đáp án chỉ được mở khi kỳ thi đã kết thúc hoặc có sự phê chuẩn của Trưởng phòng Khảo thí.
                </p>
                <div class="mb-3">
                    <label class="form-label fw-semibold small text-dark">Nhập mã PIN Bảo mật Khảo thí (*):</label>
                    <input type="password" id="pinInput" class="form-control text-center fs-4 fw-bold letter-spacing-2" placeholder="••••" maxlength="4" />
                    <small class="text-muted">Mã PIN mặc định thử nghiệm: <strong>2026</strong></small>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-dark rounded-pill px-4 fw-semibold" onclick="checkPinAndDownload()">
                    <i class="fa-solid fa-unlock me-1"></i> Mở khóa Đáp án
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal 3: Xem trước Bản in Đề thi thực tế (Exam Paper A4 Preview) -->
<div class="modal fade" id="examPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom py-3 px-4">
                <div>
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="fa-solid fa-file-lines text-primary me-2"></i> Xem trước Đề thi Chuẩn A4 (Mã đề: 101)
                    </h5>
                    <small class="text-muted">Mô phỏng bản in phát cho sinh viên trong phòng thi</small>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-primary" onclick="window.print()">
                        <i class="fa-solid fa-print me-1"></i> In thử nghiệm
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body p-4 bg-secondary-subtle">
                <!-- Mô phỏng trang giấy A4 -->
                <div class="p-5 bg-white shadow-sm mx-auto" style="max-width: 800px; min-height: 900px; font-family: 'Times New Roman', serif; color: #000; border: 1px solid #ccc;">
                    <!-- Header đề thi -->
                    <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">
                        <div class="text-center" style="width: 45%;">
                            <div class="fw-bold" style="font-size: 13px;">BỘ GIÁO DỤC VÀ ĐÀO TẠO</div>
                            <div class="fw-bold" style="font-size: 14px;">TRƯỜNG ĐẠI HỌC CÔNG NGHỆ</div>
                            <div style="font-size: 13px;">KHOA CÔNG NGHỆ THÔNG TIN</div>
                        </div>
                        <div class="text-center" style="width: 50%;">
                            <div class="fw-bold" style="font-size: 14px;">ĐỀ THI KẾT THÚC HỌC PHẦN</div>
                            <div class="fw-bold" style="font-size: 13px;">HỌC KỲ 1 - NĂM HỌC 2026 - 2027</div>
                            <div class="fw-bold text-danger" style="font-size: 14px;">MÃ ĐỀ THI: 101</div>
                        </div>
                    </div>

                    <!-- Khung thông tin học phần -->
                    <div class="mb-3" style="font-size: 13.5px; line-height: 1.6;">
                        <div><strong>Tên học phần:</strong> Cơ sở dữ liệu nâng cao (IT3020)</div>
                        <div class="d-flex justify-content-between">
                            <span><strong>Thời gian làm bài:</strong> 60 phút (Không kể phát đề)</span>
                            <span><strong>Hình thức:</strong> Trắc nghiệm khách quan</span>
                        </div>
