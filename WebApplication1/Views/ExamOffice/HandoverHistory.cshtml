@{
    ViewData["Title"] = "Lịch sử Bàn giao & Lưu trữ Đề thi - ExamBank";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Top Header Navbar -->
<div class="px-4 py-3 bg-white border-bottom d-flex align-items-center justify-content-between shadow-sm">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="ExamOffice" asp-action="Index" class="text-decoration-none text-secondary">Khảo thí & ĐBCL</a></li>
            <li class="breadcrumb-item active fw-bold" style="color: #e11d48;" aria-current="page">Lịch sử Bàn giao & Lưu trữ Đề thi</li>
        </ol>
    </nav>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-bold border border-success-subtle">
            <i class="fa-solid fa-box-archive me-1"></i> Kho đề thi: Đã niêm phong an toàn
        </span>
    </div>
</div>

<div class="p-4" style="background-color: #f8fafc; min-height: calc(100vh - 75px);">
    <!-- KPI Thống kê bàn giao -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Tổng đợt bàn giao</div>
                        <h4 class="fw-bold text-dark mt-1 mb-0">48</h4>
                        <small class="text-success fw-bold"><i class="fa-solid fa-arrow-up"></i> 100% đúng hạn</small>
                    </div>
                    <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #e11d48, #be123c);">
                        <i class="fa-solid fa-clipboard-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Đã niêm phong & bàn giao</div>
                        <h4 class="fw-bold text-dark mt-1 mb-0">42</h4>
                        <small class="text-muted">Đã ký biên bản 2 bên</small>
                    </div>
                    <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #059669, #10b981);">
                        <i class="fa-solid fa-lock fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Đang lưu kho bảo mật</div>
                        <h4 class="fw-bold text-dark mt-1 mb-0">6</h4>
                        <small class="text-warning fw-bold">Chờ ngày thi chính thức</small>
                    </div>
                    <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #d97706, #f59e0b);">
                        <i class="fa-solid fa-warehouse fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Túi đề đã hủy lưu trữ</div>
                        <h4 class="fw-bold text-dark mt-1 mb-0">12</h4>
                        <small class="text-muted">Lưu vết số hóa đầy đủ</small>
                    </div>
                    <div class="rounded-3 p-3 text-white" style="background: linear-gradient(135deg, #475569, #64748b);">
                        <i class="fa-solid fa-vault fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách biên bản bàn giao -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-3 border-bottom">
            <h5 class="fw-bold text-dark mb-0">
                <i class="fa-solid fa-clock-rotate-left me-2" style="color: #e11d48;"></i>
                Nhật ký Biên bản Bàn giao Đề thi
            </h5>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="width: 260px;">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" class="form-control bg-light border-start-0" placeholder="Tìm theo mã đợt, mã đề...">
                </div>
                <button class="btn btn-sm btn-light border px-3" title="Tải lại dữ liệu" onclick="window.location.reload();">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Mã biên bản</th>
                        <th>Học phần / Môn thi</th>
                        <th>Số túi niêm phong</th>
                        <th>Người bàn giao</th>
                        <th>Người nhận (Ban coi thi)</th>
                        <th>Thời gian bàn giao</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4 fw-bold font-monospace" style="color: #be123c;">#BB-2026-IT01</td>
                        <td>
                            <div class="fw-bold text-dark">Cơ sở dữ liệu nâng cao (IT3020)</div>
                            <small class="text-muted">4 mã đề: 101, 102, 103, 104 • 120 bài thi</small>
                        </td>
                        <td><span class="badge bg-light text-dark border px-2 py-1"><i class="fa-solid fa-shield-halved text-success me-1"></i> 04 túi chì</span></td>
                        <td>ThS. Hoàng Thị Lan</td>
                        <td>TS. Nguyễn Văn Bình (Trưởng điểm)</td>
                        <td>10/11/2026 07:15</td>
                        <td><span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-semibold">Đã niêm phong</span></td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-light border" title="Xem biên bản" onclick="alert('Biên bản bàn giao số #BB-2026-IT01: Tình trạng túi đề còn nguyên tem niêm phong chì.');">
                                <i class="fa-regular fa-file-lines text-primary"></i>
                            </button>
                            <button class="btn btn-sm btn-light border" title="In biên bản PDF" onclick="alert('Đang tải file PDF biên bản bàn giao có chữ ký số...');">
                                <i class="fa-solid fa-print text-danger"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4 fw-bold font-monospace" style="color: #be123c;">#BB-2026-CS02</td>
                        <td>
                            <div class="fw-bold text-dark">Lập trình hướng đối tượng (IT2010)</div>
                            <small class="text-muted">4 mã đề: 201, 202, 203, 204 • 240 bài thi</small>
                        </td>
                        <td><span class="badge bg-light text-dark border px-2 py-1"><i class="fa-solid fa-shield-halved text-success me-1"></i> 08 túi chì</span></td>
                        <td>ThS. Hoàng Thị Lan</td>
                        <td>ThS. Vũ Quốc Tuấn (Phó điểm)</td>
                        <td>09/11/2026 13:00</td>
                        <td><span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-semibold">Đã hoàn tất thi</span></td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-light border" title="Xem biên bản" onclick="alert('Biên bản bàn giao số #BB-2026-CS02 đã lưu trữ vào kho.');">
                                <i class="fa-regular fa-file-lines text-primary"></i>
                            </button>
                            <button class="btn btn-sm btn-light border" title="In biên bản PDF" onclick="alert('Đang tải file PDF biên bản...');">
                                <i class="fa-solid fa-print text-danger"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4 fw-bold font-monospace" style="color: #be123c;">#BB-2026-NW03</td>
                        <td>
                            <div class="fw-bold text-dark">Mạng máy tính & Truyền thông (IT3080)</div>
                            <small class="text-muted">2 mã đề: 301, 302 • 90 bài thi</small>
                        </td>
                        <td><span class="badge bg-light text-dark border px-2 py-1"><i class="fa-solid fa-lock text-warning me-1"></i> 03 túi chì</span></td>
                        <td>ThS. Hoàng Thị Lan</td>
                        <td>Chờ ban coi thi tiếp nhận</td>
                        <td>12/11/2026 08:00 (Dự kiến)</td>
                        <td><span class="badge bg-warning-subtle text-warning px-3 py-1 rounded-pill fw-semibold">Đang lưu kho</span></td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-light border" title="Xem biên bản" onclick="alert('Túi đề đang lưu tại két sắt bảo mật số 02.');">
                                <i class="fa-regular fa-file-lines text-primary"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

