@section Scripts {
<script>
    // Toggle Select All Checkbox
    function toggleSelectAll(master) {
        const checkboxes = document.querySelectorAll('.q-checkbox');
        checkboxes.forEach(cb => cb.checked = master.checked);
        onItemSelect();
    }

    // On Item Checkbox Changed
    function onItemSelect() {
        const checkedItems = document.querySelectorAll('.q-checkbox:checked');
        const count = checkedItems.length;
        const btn = document.getElementById('btnBatchSubmit');
        const countSpan = document.getElementById('selectedCount');
        
        if (count > 0) {
            btn.style.display = 'inline-block';
            countSpan.innerText = count;
        } else {
            btn.style.display = 'none';
        }
    }

    // Submit Batch Questions for Approval
    function submitBatchQuestions() {
        const checkedItems = document.querySelectorAll('.q-checkbox:checked');
        if (confirm(`Thầy/Cô có chắc chắn muốn gửi ${checkedItems.length} câu hỏi đã chọn lên Trưởng bộ môn phê duyệt?`)) {
            alert(`Đã gửi ${checkedItems.length} câu hỏi lên Trưởng bộ môn phê duyệt thành công!`);
            location.reload();
        }
    }

    // Show Feedback Modal
    function showFeedbackModal(code, author, content) {
        document.getElementById('feedbackTitle').innerHTML = `<i class="fa-solid fa-comment-dots me-2"></i>Góp ý câu ${code}`;
        document.getElementById('feedbackAuthor').innerText = author;
        document.getElementById('feedbackContent').innerText = content;
        const modal = new bootstrap.Modal(document.getElementById('feedbackModal'));
        modal.show();
    }

    // Preview Question
    function previewQuestion(code) {
        document.getElementById('previewCode').innerText = code;
        const modal = new bootstrap.Modal(document.getElementById('previewModal'));
        modal.show();
    }
</script>
}

