@{
    ViewData["Title"] = "Tạo đề thi mới theo ma trận - ExamBank";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Top Header Navbar -->
<div class="px-4 py-3 bg-white border-bottom d-flex align-items-center justify-content-between shadow-sm">
    <div class="d-flex align-items-center gap-3">
        <a asp-action="Exams" class="btn btn-light rounded-3 border p-2 text-secondary" title="Quay lại danh sách đề thi">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Teacher" asp-action="Index" class="text-decoration-none text-secondary">Giảng viên</a></li>
                <li class="breadcrumb-item"><a asp-controller="Teacher" asp-action="Exams" class="text-decoration-none text-secondary">Quản lý đề thi</a></li>
                <li class="breadcrumb-item active fw-semibold text-success" aria-current="page">Tạo đề thi mới theo ma trận</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Exams" class="btn btn-light border rounded-3 px-3 text-secondary">Hủy</a>
        <button type="button" class="btn btn-outline-secondary rounded-3 px-3" onclick="alert('Đã lưu cấu hình ma trận đề vào bản nháp!');">
            <i class="fa-regular fa-floppy-disk me-1"></i> Lưu bản nháp
        </button>
        <button type="button" class="btn btn-success fw-bold rounded-3 px-4 shadow-sm" onclick="finishGenerateExam();">
            <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Sinh đề thi & Lưu lại
        </button>
    </div>
</div>

<!-- Main Container -->
<div class="p-4 flex-grow-1" style="background-color: #f4f6fa;">
    <div class="container-fluid" style="max-width: 1200px;">
        
        <!-- Quy trình 3 bước trực quan -->
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
            <div class="row text-center g-2 fs-7 fw-semibold">
                <div class="col-4 text-primary">
                    <span class="badge bg-primary rounded-circle p-2 me-1">1</span>
                    <span>1. Thông tin chung & Kỳ thi</span>
                </div>
                <div class="col-4 text-success border-start">
                    <span class="badge bg-success rounded-circle p-2 me-1">2</span>
                    <span>2. Thiết lập Ma trận đề thi</span>
                </div>
                <div class="col-4 text-muted border-start">
                    <span class="badge bg-light text-dark border rounded-circle p-2 me-1">3</span>
                    <span>3. Xáo trộn & Xuất đề thi</span>
                </div>
            </div>
        </div>

        <form id="createExamForm">
            <div class="row g-4 mb-4">
                
                <!-- CỘT TRÁI (8 CỘT): MA TRẬN ĐỀ THI -->
                <div class="col-lg-8">
                    
                    <!-- Card 1: Thiết lập ma trận câu hỏi -->
                    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
                        <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="fw-bold text-dark mb-0">
                                    <i class="fa-solid fa-table-cells me-2 text-primary"></i>Ma trận đề thi (Độ khó Bloom & Chương)
                                </h6>
                                <small class="text-muted">Rút câu hỏi tự động từ ngân hàng <strong>Đã duyệt</strong> theo đúng tỷ lệ</small>
                            </div>
                            <span class="badge bg-success py-1 px-3 fs-7">Tổng: 40 câu / 10.0 điểm</span>
                        </div>
                        <div class="card-body p-4 pt-0">
                            
                            <div class="table-responsive">
                                <table class="table table-bordered align-middle text-center fs-7 mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-start" style="width: 200px;">Nội dung / Chương</th>
                                            <th class="text-info" style="width: 100px;">Nhận biết (0.25đ)</th>
                                            <th class="text-warning-emphasis" style="width: 100px;">Thông hiểu (0.25đ)</th>
                                            <th class="text-success" style="width: 100px;">Vận dụng (0.25đ)</th>
                                            <th class="text-danger" style="width: 100px;">Vận dụng cao (0.25đ)</th>
                                            <th class="fw-bold" style="width: 80px;">Tổng câu</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td class="text-start fw-semibold">
                                                Chương 1: Tổng quan về OOP
                                                <div class="small text-muted fw-normal">Ngân hàng có: 18 câu đạt chuẩn</div>
                                            </td>
                                            <td><input type="number" class="form-control form-control-sm text-center" value="4" min="0" /></td>
                                            <td><input type="number" class="form-control form-control-sm text-center" value="2" min="0" /></td>
                                            <td><input type="number" class="form-control form-control-sm text-center" value="1" min="0" /></td>
                                            <td><input type="number" class="form-control form-control-sm text-center" value="0" min="0" /></td>
                                            <td class="fw-bold text-primary">7</td>
                                        </tr>
                                        <tr>
                                            <td class="text-start fw-semibold">
                                                Chương 2: Lớp và Đối tượng
                                                <div class="small text-muted fw-normal">Ngân hàng có: 34 câu đạt chuẩn</div>
                                            </td>
                                            <td><input type="number" class="form-control form-control-sm text-center" value="6" min="0" /></td>
                                            <td><input type="number" class="form-control form-control-sm text-center" value="4" min="0" /></td>
                                            <td><input type="number" class="form-control form-control-sm text-center" value="2" min="0" /></td>
                                            <td><input type="number" class="form-control form-control-sm text-center" value="1" min="0" /></td>
                                            <td class="fw-bold text-primary">13</td>
                                        </tr>
                                        <tr>
                                            <td class="text-start fw-semibold">
                                                Chương 3: Tính Kế thừa & Đa hình
                                                <div class="small text-muted fw-normal">Ngân hàng có: 45 câu đạt chuẩn</div>
                                            </td>
                                            <td><input type="number" class="form-control form-control-sm text-center" value="6" min="0" /></td>
                                            <td><input type="number" class="form-control form-control-sm text-center" value="6" min="0" /></td>
                                            <td><input type="number" class="form-control form-control-sm text-center" value="5" min="0" /></td>
                                            <td><input type="number" class="form-control form-control-sm text-center" value="3" min="0" /></td>
                                            <td class="fw-bold text-primary">20</td>
                                        </tr>
                                        <tr class="table-light fw-bold">
                                            <td class="text-start">TỔNG CỘNG</td>
                                            <td class="text-info">16 câu (40%)</td>
                                            <td class="text-warning-emphasis">12 câu (30%)</td>
                                            <td class="text-success">8 câu (20%)</td>
                                            <td class="text-danger">4 câu (10%)</td>
                                            <td class="text-primary fs-6">40 câu</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="mt-3 p-3 bg-light rounded-3 d-flex align-items-center justify-content-between">
                                <div class="small text-secondary">
                                    <i class="fa-solid fa-circle-check text-success me-1"></i>
                                    Số lượng câu hỏi trong ngân hàng <strong>Đã duyệt</strong> hoàn toàn đáp ứng đủ ma trận trên.
                                </div>
                                <button type="button" class="btn btn-primary btn-sm px-3 fw-bold rounded-3" onclick="previewDrawQuestions();">
                                    <i class="fa-solid fa-shuffle me-1"></i> Rút ngẫu nhiên câu hỏi
                                </button>
                            </div>

                        </div>
                    </div>

                    <!-- Card 2: Danh sách câu hỏi đã rút ra theo ma trận (Preview) -->
                    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4" id="drawnQuestionsCard">
                        <div class="card-header bg-white border-0 py-3 px-4 d-flex align-items-center justify-content-between">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa-solid fa-clipboard-check me-2 text-success"></i>Xem trước các câu hỏi được rút vào đề thi
                            </h6>
                            <span class="badge bg-light text-secondary border">Mã đề gốc: 100</span>
                        </div>
                        <div class="card-body p-4 pt-0">
                            
                            <div class="list-group list-group-flush fs-7">
                                
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="fw-bold text-primary">Câu 1 (Mã: CS201-Q104)</span>
                                        <span class="badge bg-info text-dark">Nhận biết • 0.25đ</span>
                                    </div>
                                    <p class="mb-1 text-dark fw-medium">Nguyên lý Đóng gói (Encapsulation) trong OOP nhằm mục đích chính nào dưới đây?</p>
                                    <div class="small text-success fw-bold"><i class="fa-solid fa-check me-1"></i>Đáp án: A. Che giấu trạng thái nội tại...</div>
                                </div>

                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="fw-bold text-primary">Câu 2 (Mã: CS201-Q089)</span>
                                        <span class="badge bg-warning text-dark">Thông hiểu • 0.25đ</span>
                                    </div>
                                    <p class="mb-1 text-dark fw-medium">Phương thức ảo (virtual method) khác với phương thức trừu tượng (abstract method) ở điểm nào?</p>
                                    <div class="small text-success fw-bold"><i class="fa-solid fa-check me-1"></i>Đáp án: B. Virtual method có thân triển khai mặc định...</div>
                                </div>

                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="fw-bold text-primary">Câu 3 (Mã: CS201-Q077)</span>
                                        <span class="badge bg-success text-white">Vận dụng • 0.25đ</span>
                                    </div>
                                    <p class="mb-1 text-dark fw-medium">Cho đoạn mã khởi tạo đối tượng đa hình <code>Animal a = new Dog(); a.Speak();</code>. Kết quả màn hình in ra gì?</p>
                                    <div class="small text-success fw-bold"><i class="fa-solid fa-check me-1"></i>Đáp án: D. "Gâu gâu" (Gọi hàm lớp con)</div>
                                </div>

                            </div>

                            <div class="text-center mt-3 pt-2 border-top">
                                <small class="text-muted">... và 37 câu hỏi khác đã được tự động tuyển chọn ...</small>
                            </div>

                        </div>
                    </div>

                </div>

                <!-- CỘT PHẢI (4 CỘT): THÔNG TIN ĐỀ THI & CẤU HÌNH XÁO TRỘN -->
                <div class="col-lg-4">
                    
                    <!-- Thông tin đề thi -->
                    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
                        <div class="card-header bg-white border-0 py-3 px-4">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa-solid fa-circle-info me-2 text-primary"></i>Thông tin đề thi
                            </h6>
                        </div>
                        <div class="card-body p-4 pt-0">
                            
                            <div class="mb-3">
                                <label class="form-label fw-semibold fs-7 text-dark">Môn thi <span class="text-danger">*</span></label>
                                <select class="form-select bg-light">
                                    <option selected>Lập trình Hướng đối tượng (CS201)</option>
                                    <option>Cấu trúc dữ liệu & GT (DS102)</option>
                                    <option>Cơ sở dữ liệu nâng cao (DB301)</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold fs-7 text-dark">Tên kỳ thi / Đề thi <span class="text-danger">*</span></label>
                                <input type="text" class="form-control bg-light" value="Đề thi kết thúc học phần Kỳ 1 - Năm 2026" />
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label fw-semibold fs-7 text-dark">Thời gian thi</label>
                                    <select class="form-select bg-light">
                                        <option>45 phút</option>
                                        <option selected>60 phút</option>
                                        <option>90 phút</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="form-label fw-semibold fs-7 text-dark">Thang điểm</label>
                                    <input type="text" class="form-control bg-light" value="10.0 điểm" disabled />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold fs-7 text-dark">Hình thức thi</label>
                                <select class="form-select bg-light">
                                    <option selected>Trắc nghiệm trên giấy (Tô phiếu trả lời)</option>
                                    <option>Trắc nghiệm trên phòng máy tính</option>
                                </select>
                            </div>

                        </div>
                    </div>

                    <!-- Cấu hình hoán vị xáo trộn mã đề -->
                    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
                        <div class="card-header bg-white border-0 py-3 px-4">
                            <h6 class="fw-bold text-dark mb-0">
                                <i class="fa-solid fa-shuffle me-2 text-success"></i>Cấu hình xáo trộn (Hoán vị)
                            </h6>
                        </div>
                        <div class="card-body p-4 pt-0">
                            
                            <div class="mb-3">
                                <label class="form-label fw-semibold fs-7 text-dark">Số lượng mã đề cần tạo</label>
                                <select class="form-select bg-light">
                                    <option>02 Mã đề (101, 102)</option>
                                    <option selected>04 Mã đề (101, 102, 103, 104)</option>
                                    <option>06 Mã đề</option>
                                    <option>08 Mã đề</option>
                                </select>
                            </div>

                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="shuffleQuestions" checked />
                                <label class="form-check-label fs-7" for="shuffleQuestions">
                                    Đảo ngẫu nhiên thứ tự các câu hỏi
                                </label>
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="shuffleAnswers" checked />
                                <label class="form-check-label fs-7" for="shuffleAnswers">
                                    Đảo ngẫu nhiên thứ tự các đáp án A, B, C, D
                                </label>
                            </div>

                            <div class="alert alert-info py-2 px-3 small rounded-3 mb-0">
                                <i class="fa-solid fa-shield-halved me-1"></i> Hệ thống tự động tạo mã ma trận và bảng đáp án đối soát tương ứng cho từng mã đề hoán vị.
                            </div>

                        </div>
                    </div>

                </div>

            </div>
        </form>

    </div>
</div>

@section Scripts {
<script>
    function previewDrawQuestions() {
        alert('Đã rút ngẫu nhiên thành công 40 câu hỏi đạt chuẩn từ ngân hàng câu hỏi đã duyệt theo đúng ma trận!');
        document.getElementById('drawnQuestionsCard').scrollIntoView({ behavior: 'smooth' });
    }

    function finishGenerateExam() {
        alert('Tạo đề thi thành công!\n- Đã sinh xong 04 mã đề hoán vị (101, 102, 103, 104).\n- Đã sẵn sàng xuất bản và gửi cho Phòng Khảo thí in sao niêm phong.');
        window.location.href = '@Url.Action("Exams", "Teacher")';
    }
</script>
}

