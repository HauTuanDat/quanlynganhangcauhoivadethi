                            <span>Soạn câu hỏi mới</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a asp-controller="Teacher" asp-action="Import" class="sidebar-link @(curController == "Teacher" && curAction == "Import" ? "active-teacher" : "")">
                            <i class="fa-solid fa-file-import"></i>
                            <span>Nhập từ Word / Excel</span>
                        </a>
                    </li>

                    <li class="menu-category" style="color: #6ee7b7;">Quản lý đề thi</li>
                    <li class="sidebar-nav-item">
                        <a asp-controller="Teacher" asp-action="Exams" class="sidebar-link @(curController == "Teacher" && curAction == "Exams" ? "active-teacher" : "")">
