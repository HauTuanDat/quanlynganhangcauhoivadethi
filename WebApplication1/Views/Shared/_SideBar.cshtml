@using System.Security.Claims
@{
    var curController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var curAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<style>
    /* Custom Sidebar Styling - Deep Navy Blue Theme (Theo tông màu Hình 2) */
    .admin-sidebar {
        width: 270px;
        min-height: 100vh;
        background: linear-gradient(180deg, #0d1e46 0%, #091431 100%);
        color: #ffffff;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        box-shadow: 4px 0 16px rgba(0, 0, 0, 0.15);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        user-select: none;
    }

    /* Logo Header */
    .sidebar-header {
        padding: 22px 20px 18px 20px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .sidebar-logo-icon {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, #1d4ed8, #3b82f6);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 20px;
        box-shadow: 0 4px 10px rgba(29, 78, 216, 0.4);
        margin-right: 14px;
        flex-shrink: 0;
    }

    .sidebar-title {
        font-size: 17px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #ffffff;
        line-height: 1.2;
    }

    .sidebar-subtitle {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.2px;
        color: #93c5fd;
        text-transform: uppercase;
        margin-top: 2px;
    }

    /* Scrollable Menu */
    .sidebar-menu {
        padding: 16px 14px;
        overflow-y: auto;
        flex-grow: 1;
    }

    /* Section Category Header */
    .menu-category {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: #7c94bd;
        padding: 16px 14px 6px 14px;
    }

    /* Navigation Links */
    .sidebar-nav-item {
        margin-bottom: 4px;
        list-style: none;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        border-radius: 9px;
        color: #cbd5e1;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
    }

    .sidebar-link i {
        font-size: 16px;
        width: 24px;
        margin-right: 12px;
        text-align: center;
        color: #94a3b8;
        transition: color 0.2s ease;
    }

    /* Hover State */
    .sidebar-link:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
    }

    .sidebar-link:hover i {
        color: #ffffff;
    }

    /* Active State (Tựa như Dashboard trong Hình 1 & Màu xanh rực ở Hình 2) */
    .sidebar-link.active {
        background: #2563eb;
        color: #ffffff;
        font-weight: 600;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
    }

    .sidebar-link.active i {
        color: #ffffff;
    }

    /* Footer Bottom Section */
    .sidebar-footer {
        padding: 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(0, 0, 0, 0.12);
    }

    .sidebar-link-logout {
        color: #fca5a5 !important;
    }

    .sidebar-link-logout i {
        color: #ef4444 !important;
    }

    .sidebar-link-logout:hover {
        background: rgba(239, 68, 68, 0.15) !important;
        color: #ffffff !important;
    }
</style>

<aside class="admin-sidebar">
    <div>
        <!-- 1. HEADER: EXAMBANK ADMINISTRATOR -->
        <div class="sidebar-header">
            <div class="sidebar-logo-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div>
                <div class="sidebar-title">EXAMBANK</div>
                <div class="sidebar-subtitle">Administrator</div>
            </div>
        </div>

        <!-- 2. DANH SÁCH MENU (THEO CẤU TRÚC HÌNH 1) -->
        <div class="sidebar-menu">
            <ul class="p-0 m-0">
                <!-- NÚT DASHBOARD (ĐANG ACTIVE) -->
                <li class="sidebar-nav-item">
                    <a asp-controller="Admin" asp-action="Index" class="sidebar-link @(curController == "Admin" && curAction == "Index" ? "active" : "")">
                        <i class="fa-solid fa-table-cells-large"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <!-- NHÓM 1: QUẢN LÝ NGƯỜI DÙNG -->
                <li class="menu-category">Quản lý người dùng</li>
                <li class="sidebar-nav-item">
                    <a asp-controller="Admin" asp-action="Users" class="sidebar-link @(curController == "Admin" && curAction == "Users" ? "active" : "")">
                        <i class="fa-solid fa-users"></i>
                        <span>Quản lý tài khoản</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a asp-controller="Admin" asp-action="Roles" class="sidebar-link @(curController == "Admin" && curAction == "Roles" ? "active" : "")">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Vai trò & phân quyền</span>
                    </a>
                </li>

                <!-- NHÓM 2: QUẢN LÝ DANH MỤC -->
                <li class="menu-category">Quản lý danh mục</li>
                <li class="sidebar-nav-item">
                    <a asp-controller="Admin" asp-action="Departments" class="sidebar-link @(curController == "Admin" && curAction == "Departments" ? "active" : "")">
                        <i class="fa-solid fa-landmark"></i>
                        <span>Khoa & bộ môn</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a asp-controller="Admin" asp-action="Subjects" class="sidebar-link @(curController == "Admin" && curAction == "Subjects" ? "active" : "")">
                        <i class="fa-solid fa-book-open"></i>
                        <span>Quản lý môn học</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a asp-controller="Admin" asp-action="Topics" class="sidebar-link @(curController == "Admin" && curAction == "Topics" ? "active" : "")">
                        <i class="fa-solid fa-diagram-project"></i>
                        <span>Chương & chủ đề</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a asp-controller="Admin" asp-action="QuestionTypes" class="sidebar-link @(curController == "Admin" && curAction == "QuestionTypes" ? "active" : "")">
                        <i class="fa-solid fa-list-check"></i>
                        <span>Loại câu hỏi & độ khó</span>
                    </a>
                </li>

                <!-- NHÓM 3: QUẢN TRỊ HỆ THỐNG -->
                <li class="menu-category">Quản trị hệ thống</li>
                <li class="sidebar-nav-item">
                    <a asp-controller="Admin" asp-action="Settings" class="sidebar-link @(curController == "Admin" && curAction == "Settings" ? "active" : "")">
                        <i class="fa-solid fa-gear"></i>
                        <span>Cấu hình hệ thống</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a asp-controller="Admin" asp-action="ActivityLogs" class="sidebar-link @(curController == "Admin" && curAction == "ActivityLogs" ? "active" : "")">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>Nhật ký hoạt động</span>
                    </a>
                </li>
                <li class="sidebar-nav-item">
                    <a asp-controller="Admin" asp-action="Reports" class="sidebar-link @(curController == "Admin" && curAction == "Reports" ? "active" : "")">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>Báo cáo & thống kê</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- 3. CHÂN SIDEBAR: HỒ SƠ & ĐĂNG XUẤT -->
    <div class="sidebar-footer">
        <ul class="p-0 m-0">
            <li class="sidebar-nav-item">
                <a asp-controller="Admin" asp-action="Profile" class="sidebar-link @(curController == "Admin" && curAction == "Profile" ? "active" : "")">
                    <i class="fa-regular fa-circle-user"></i>
                    <span>Hồ sơ cá nhân</span>
                </a>
            </li>
            <li class="sidebar-nav-item">
                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                    <a href="javascript:void(0);" onclick="document.getElementById('logoutForm').submit();" class="sidebar-link sidebar-link-logout">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Đăng xuất</span>
                    </a>
                </form>
            </li>
        </ul>
    </div>
</aside>
