                    <i class="fa-solid fa-stamp"></i>
                </div>
                <div class="sidebar-header-text">
                    <div class="sidebar-title">EXAMBANK</div>
                    <div class="sidebar-subtitle sidebar-subtitle-examoffice">Khảo Thí & ĐBCL</div>
                </div>
                <button type="button" class="btn btn-sm btn-link p-1 ms-auto sidebar-collapse-btn d-none d-lg-flex align-items-center justify-content-center" id="sidebarCollapseBtn" title="Thu gọn / Mở rộng sidebar">
                    <i class="fa-solid fa-angles-left"></i>
                </button>
            </div>

            <!-- DANH SÁCH MENU PHÒNG KHẢO THÍ -->
            <div class="sidebar-menu">
                <ul class="p-0 m-0">
                    <!-- TỔNG QUAN -->
                    <li class="sidebar-nav-item">
                        <a asp-controller="ExamOffice" asp-action="Index" class="sidebar-link @(curController == "ExamOffice" && curAction == "Index" ? "active-examoffice" : "")">
                            <i class="fa-solid fa-table-cells-large"></i>
                            <span>Bàn làm việc</span>
