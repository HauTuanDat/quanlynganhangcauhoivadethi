                        </a>
                    </li>

                    <li class="menu-category" style="color: #a5b4fc;">Công việc giảng dạy</li>
                    <li class="sidebar-nav-item">
                        <a asp-controller="Teacher" asp-action="Questions" class="sidebar-link @(curController == "Teacher" && curAction == "Questions" ? "active-hod" : "")">
                            <i class="fa-solid fa-pen-to-square"></i>
                            <span>Soạn câu hỏi của tôi</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a asp-controller="Teacher" asp-action="Exams" class="sidebar-link @(curController == "Teacher" && curAction == "Exams" ? "active-hod" : "")">
                            <i class="fa-solid fa-file-lines"></i>
                            <span>Đề thi của tôi</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        else if (isTeacher)
        {
            <!-- ============================================================== -->
            <!-- 3. HEADER CỔNG GIẢNG VIÊN                                      -->
            <!-- ============================================================== -->
            <div class="sidebar-header">
                <div class="sidebar-logo-icon sidebar-logo-teacher">
                    <i class="fa-solid fa-chalkboard-user"></i>
                </div>
                <div class="sidebar-header-text">
                    <div class="sidebar-title">EXAMBANK</div>
                    <div class="sidebar-subtitle sidebar-subtitle-teacher">Cổng Giảng Viên</div>
                </div>
                <button type="button" class="btn btn-sm btn-link p-1 ms-auto sidebar-collapse-btn d-none d-lg-flex align-items-center justify-content-center" id="sidebarCollapseBtn" title="Thu gọn / Mở rộng sidebar">
                    <i class="fa-solid fa-angles-left"></i>
