@using System.Security.Claims
@{
    var curController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var curAction = ViewContext.RouteData.Values["Action"]?.ToString();

    // Xác định vai trò của người dùng đang đăng nhập
    var isAdmin = User.IsInRole("Admin");
    var isExamOffice = User.IsInRole("PhongKhaoThi");
    var isHOD = User.IsInRole("TruongBoMon");
    var isTeacher = User.IsInRole("GiangVien");

    // Dự phòng kiểm tra qua Claim nếu IsInRole chưa kích hoạt tức thời
    if (!isAdmin && !isExamOffice && !isHOD && !isTeacher)
    {
        var roleClaim = User.FindFirst(ClaimTypes.Role)?.Value;
        isAdmin = (roleClaim == "Admin");
        isExamOffice = (roleClaim == "PhongKhaoThi");
        isHOD = (roleClaim == "TruongBoMon");
        isTeacher = (roleClaim == "GiangVien");
    }
}

<style>
    /* Custom Sidebar Styling - Deep Navy Blue Theme */
    .admin-sidebar {
        width: 255px; /* Sidebar Width: 240-260px */
        min-height: 100vh;
        background: linear-gradient(180deg, #0d1e46 0%, #091431 100%);
        color: #ffffff;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        box-shadow: 4px 0 16px rgba(0, 0, 0, 0.15);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        user-select: none;
    }

    /* Logo Header */
    .sidebar-header {
        padding: 22px 20px 18px 20px;
        display: flex;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .sidebar-logo-icon {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, #1d4ed8, #3b82f6);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 20px;
        box-shadow: 0 4px 10px rgba(29, 78, 216, 0.4);
        margin-right: 14px;
        flex-shrink: 0;
    }

    .sidebar-logo-teacher {
        background: linear-gradient(135deg, #059669, #10b981) !important;
        box-shadow: 0 4px 10px rgba(5, 150, 105, 0.4) !important;
    }

    .sidebar-logo-hod {
        background: linear-gradient(135deg, #4f46e5, #7c3aed) !important;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.4) !important;
    }

    .sidebar-logo-examoffice {
        background: linear-gradient(135deg, #be123c, #e11d48) !important;
        box-shadow: 0 4px 10px rgba(225, 29, 72, 0.4) !important;
    }

    .sidebar-title {
        font-size: 17px;
        font-weight: 800;
        letter-spacing: 0.5px;
        color: #ffffff;
        line-height: 1.2;
    }

    .sidebar-subtitle {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.2px;
        color: #93c5fd;
        text-transform: uppercase;
        margin-top: 2px;
    }

    .sidebar-subtitle-teacher {
        color: #6ee7b7 !important;
    }

    .sidebar-subtitle-hod {
        color: #a5b4fc !important;
    }

    .sidebar-subtitle-examoffice {
        color: #fda4af !important;
    }

    /* Scrollable Menu */
    .sidebar-menu {
        padding: 16px 14px;
        overflow-y: auto;
        flex-grow: 1;
    }

    /* Section Category Header */
    .menu-category {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: #7c94bd;
        padding: 16px 14px 6px 14px;
    }

    /* Navigation Links */
    .sidebar-nav-item {
        margin-bottom: 4px;
        list-style: none;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        border-radius: 9px;
        color: #cbd5e1;
        font-size: 14.5px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease-in-out;
    }

    .sidebar-link i {
        font-size: 16px;
        width: 24px;
        margin-right: 12px;
        text-align: center;
        color: #94a3b8;
        transition: color 0.2s ease;
    }

    /* Hover State */
    .sidebar-link:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #ffffff;
    }

    .sidebar-link:hover i {
        color: #ffffff;
    }

    /* Active States */
    .sidebar-link.active {
        background: #2563eb;
        color: #ffffff;
        font-weight: 600;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
    }

    .sidebar-link.active-teacher {
        background: #059669 !important;
        color: #ffffff !important;
        font-weight: 600 !important;
        box-shadow: 0 4px 14px rgba(5, 150, 105, 0.4) !important;
    }

    .sidebar-link.active-hod {
        background: #4f46e5 !important;
        color: #ffffff !important;
        font-weight: 600 !important;
        box-shadow: 0 4px 14px rgba(79, 70, 229, 0.4) !important;
    }

    .sidebar-link.active-examoffice {
        background: #e11d48 !important;
        color: #ffffff !important;
        font-weight: 600 !important;
        box-shadow: 0 4px 14px rgba(225, 29, 72, 0.4) !important;
    }

    .sidebar-link.active i,
    .sidebar-link.active-teacher i,
    .sidebar-link.active-hod i,
    .sidebar-link.active-examoffice i {
        color: #ffffff;
    }

    /* Footer Bottom Section */
    .sidebar-footer {
        padding: 14px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(0, 0, 0, 0.12);
    }

    .sidebar-link-logout {
        color: #fca5a5 !important;
    }

    .sidebar-link-logout i {
        color: #ef4444 !important;
    }

    .sidebar-link-logout:hover {
        background: rgba(239, 68, 68, 0.15) !important;
        color: #ffffff !important;
    }
</style>

<aside class="admin-sidebar" id="adminSidebar">
