                            <i class="fa-solid fa-book-bookmark"></i>
                            <span>Ngân hàng câu hỏi</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a asp-controller="DepartmentHead" asp-action="LecturerProgress" class="sidebar-link @(curController == "DepartmentHead" && curAction == "LecturerProgress" ? "active-hod" : "")">
                            <i class="fa-solid fa-bars-progress"></i>
