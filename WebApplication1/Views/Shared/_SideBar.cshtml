                            <span>Chương & chủ đề</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a asp-controller="Admin" asp-action="QuestionTypes" class="sidebar-link @(curController == "Admin" && curAction == "QuestionTypes" ? "active" : "")">
                            <i class="fa-solid fa-list-check"></i>
                            <span>Loại câu hỏi & độ khó</span>
                        </a>
                    </li>

                    <li class="menu-category">Quản trị hệ thống</li>
                    <li class="sidebar-nav-item">
                        <a asp-controller="Admin" asp-action="Settings" class="sidebar-link @(curController == "Admin" && curAction == "Settings" ? "active" : "")">
                            <i class="fa-solid fa-gear"></i>
                            <span>Cấu hình hệ thống</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a asp-controller="Admin" asp-action="ActivityLogs" class="sidebar-link @(curController == "Admin" && curAction == "ActivityLogs" ? "active" : "")">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            <span>Nhật ký hoạt động</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a asp-controller="Admin" asp-action="Reports" class="sidebar-link @(curController == "Admin" && curAction == "Reports" ? "active" : "")">
                            <i class="fa-solid fa-chart-line"></i>
                            <span>Báo cáo & thống kê</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
    </div>

    <!-- 3. CHÂN SIDEBAR: HỒ SƠ & ĐĂNG XUẤT -->
    <div class="sidebar-footer">
        <ul class="p-0 m-0">
            <li class="sidebar-nav-item">
                @if (isExamOffice)
                {
                    <a asp-controller="ExamOffice" asp-action="Profile" class="sidebar-link @(curController == "ExamOffice" && curAction == "Profile" ? "active-examoffice" : "")">
                        <i class="fa-regular fa-circle-user"></i>
                        <span>Hồ sơ cá nhân</span>
                    </a>
                }
                else if (isHOD)
                {
                    <a asp-controller="DepartmentHead" asp-action="Profile" class="sidebar-link @(curController == "DepartmentHead" && curAction == "Profile" ? "active-hod" : "")">
                        <i class="fa-regular fa-circle-user"></i>
                        <span>Hồ sơ cá nhân</span>
                    </a>
                }
                else if (isTeacher)
                {
                    <a asp-controller="Teacher" asp-action="Profile" class="sidebar-link @(curController == "Teacher" && curAction == "Profile" ? "active-teacher" : "")">
                        <i class="fa-regular fa-circle-user"></i>
                        <span>Hồ sơ cá nhân</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Admin" asp-action="Profile" class="sidebar-link @(curController == "Admin" && curAction == "Profile" ? "active" : "")">
                        <i class="fa-regular fa-circle-user"></i>
                        <span>Hồ sơ cá nhân</span>
                    </a>
                }
            </li>
            <li class="sidebar-nav-item">
                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                    <a href="javascript:void(0);" onclick="document.getElementById('logoutForm').submit();" class="sidebar-link sidebar-link-logout">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Đăng xuất</span>
                    </a>
                </form>
            </li>
        </ul>
    </div>
</aside>
