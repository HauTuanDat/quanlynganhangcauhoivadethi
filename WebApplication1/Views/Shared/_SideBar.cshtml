            </div>

            <!-- DANH SÁCH MENU ADMIN -->
            <div class="sidebar-menu">
                <ul class="p-0 m-0">
                    <li class="sidebar-nav-item">
                        <a asp-controller="Admin" asp-action="Index" class="sidebar-link @(curController == "Admin" && curAction == "Index" ? "active" : "")">
                            <i class="fa-solid fa-table-cells-large"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>

                    <li class="menu-category">Quản lý người dùng</li>
                    <li class="sidebar-nav-item">
                        <a asp-controller="Admin" asp-action="Users" class="sidebar-link @(curController == "Admin" && curAction == "Users" ? "active" : "")">
                            <i class="fa-solid fa-users"></i>
                            <span>Quản lý tài khoản</span>
                        </a>
                    </li>
                    <li class="sidebar-nav-item">
                        <a asp-controller="Admin" asp-action="Roles" class="sidebar-link @(curController == "Admin" && curAction == "Roles" ? "active" : "")">
                            <i class="fa-solid fa-shield-halved"></i>
                            <span>Vai trò & phân quyền</span>
                        </a>
                    </li>

                    <li class="menu-category">Quản lý danh mục</li>
