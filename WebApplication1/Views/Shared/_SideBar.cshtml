                    </li>
                    <li class="sidebar-nav-item">
                        <a asp-controller="ExamOffice" asp-action="ExamReviews" class="sidebar-link d-flex justify-content-between align-items-center @(curController == "ExamOffice" && curAction == "ExamReviews" ? "active-examoffice" : "")">
